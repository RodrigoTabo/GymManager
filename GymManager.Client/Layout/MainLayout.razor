@inject GymManager.Web.Security.JwtAuthStateProvider JwtAuthStateProvider
@inject GymManager.Web.Security.ApiHttpClientProvider ApiHttpClientProvider
@inject NavigationManager Navigation
@inherits LayoutComponentBase

<MudThemeProvider />
<MudDialogProvider />
<MudPopoverProvider />
<MudSnackbarProvider />

<MudAppBar Elevation="1" Dense="true">
    <MudText Typo="Typo.h6">GymManager</MudText>
</MudAppBar>

<MudLayout>
    <MudDrawer Open="true"
               Anchor="Anchor.Left"
               Variant="DrawerVariant.Persistent"
               Elevation="1"
               Width="260px"
               Class="pt-16">

        <MudDrawerHeader>
            <MudText Typo="Typo.h6">GymManager</MudText>
        </MudDrawerHeader>

        <br />

        <MudText Typo="Typo.caption" Class="px-3 mt-2 mud-text-secondary">DASHBOARD</MudText>
        <MudNavMenu Dense="true">
            <MudNavLink Href="@($"/sucursal/{CurrentSucursalId}/dashboard")" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                General
            </MudNavLink>
            <MudNavLink Href="@($"/sucursal/{CurrentSucursalId}/asistencia")" Icon="@Icons.Material.Filled.FactCheck">
                Asistencias
            </MudNavLink>
        </MudNavMenu>

        <br />

        <MudText Typo="Typo.caption" Class="px-3 mt-2 mud-text-secondary">OPERACIONES</MudText>
        <MudNavMenu Dense="true">
            <MudNavLink Href="@($"/sucursal/{CurrentSucursalId}/asistencia/config")" Icon="@Icons.Material.Filled.CheckCircle">
                Asistencia
            </MudNavLink>
            <MudNavLink Href="@($"/sucursal/{CurrentSucursalId}/intentosaccesos")" Icon="@Icons.Material.Filled.Login">
                Intentos de accesos
            </MudNavLink>
        </MudNavMenu>

        <br />

        <MudText Typo="Typo.caption" Class="px-3 mt-2 mud-text-secondary">COBRANZAS</MudText>
        <MudNavMenu Dense="true">
            <MudNavLink Href="@($"/sucursal/{CurrentSucursalId}/pagos")" Icon="@Icons.Material.Filled.Payments">
                Pagos
            </MudNavLink>
            <MudNavLink Href="@($"/sucursal/{CurrentSucursalId}/vencidos")" Icon="@Icons.Material.Filled.WarningAmber">
                Vencidos
            </MudNavLink>
        </MudNavMenu>

        <br />

        <MudText Typo="Typo.caption" Class="px-3 mt-2 mud-text-secondary">ADMINISTRACIÓN</MudText>
        <MudNavMenu Dense="true">
            <MudNavLink Href="@($"/sucursal/{CurrentSucursalId}/socios")" Icon="@Icons.Material.Filled.Group">
                Socios
            </MudNavLink>
            <MudNavLink Href="@($"/sucursal/{CurrentSucursalId}/planes")" Icon="@Icons.Material.Filled.LibraryBooks">
                Planes
            </MudNavLink>
        </MudNavMenu>

        <MudButton OnClick="CambiarSucursal" Variant="Variant.Text" Color="Color.Primary">
            Cambiar sucursal
        </MudButton>

        <MudButton OnClick="Logout" Variant="Variant.Text" Color="Color.Error">
            Salir
        </MudButton>
    </MudDrawer>

    <MudMainContent Class="pt-16">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-0">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private Guid? CurrentSucursalId => TryGetSucursalIdFromUrl();

    private Guid? TryGetSucursalIdFromUrl()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var segments = relativePath.Split('/', StringSplitOptions.RemoveEmptyEntries);

        if (segments.Length >= 2 &&
            segments[0].Equals("sucursal", StringComparison.OrdinalIgnoreCase) &&
            Guid.TryParse(segments[1], out var sucursalId))
        {
            return sucursalId;
        }

        return null;
    }

    private void CambiarSucursal()
    {
        Navigation.NavigateTo("/sucursales");
    }

    private async Task Logout()
    {
        await JwtAuthStateProvider.MarkUserAsLoggedOutAsync();
        ApiHttpClientProvider.ClearAuthorization();
        Navigation.NavigateTo("/login");
    }
}