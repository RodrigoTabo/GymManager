@inherits LayoutComponentBase

<MudThemeProvider />
<MudDialogProvider />
<MudPopoverProvider />
<MudSnackbarProvider />

<!-- TOP BAR -->
<MudAppBar Elevation="1" Dense="true">
    <MudText Typo="Typo.h6">GymManager</MudText>
</MudAppBar>

<MudLayout>


    <!-- SIDEBAR -->
    <MudDrawer Open="true"
               Anchor="Anchor.Left"
               Variant="DrawerVariant.Persistent"
               Elevation="1"
               Width="260px"
               Class="pt-16">

        <MudDrawerHeader>
            <MudText Typo="Typo.h6">GymManager</MudText>
        </MudDrawerHeader>

        <br />

        <!-- DASHBOARD -->
        <MudText Typo="Typo.caption" Class="px-3 mt-2 mud-text-secondary">DASHBOARD</MudText>
        <MudNavMenu Dense="true">
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                General
            </MudNavLink>
            <MudNavLink Href="asistencia" Icon="@Icons.Material.Filled.FactCheck">
                Asistencias
            </MudNavLink>
        </MudNavMenu>

      <br />
        
        <!-- OPERACIONES -->
        <MudText Typo="Typo.caption" Class="px-3 mt-2 mud-text-secondary">OPERACIONES</MudText>
        <MudNavMenu Dense="true">
            <MudNavLink Href="asistencia/config" Icon="@Icons.Material.Filled.CheckCircle">
                Asistencia
            </MudNavLink>
            <MudNavLink Href="intentosaccesos" Icon="@Icons.Material.Filled.Login">
                Intentos de accesos
            </MudNavLink>
        </MudNavMenu>

        <br />

        <!-- COBRANZAS -->
        <MudText Typo="Typo.caption" Class="px-3 mt-2 mud-text-secondary">COBRANZAS</MudText>
        <MudNavMenu Dense="true">
            <MudNavLink Href="pagos" Icon="@Icons.Material.Filled.Payments">
                Pagos
            </MudNavLink>
            <MudNavLink Href="vencidos" Icon="@Icons.Material.Filled.WarningAmber">
                Vencidos
            </MudNavLink>
        </MudNavMenu>

        <br />

        <!-- ADMINISTRACIÓN -->
        <MudText Typo="Typo.caption" Class="px-3 mt-2 mud-text-secondary">ADMINISTRACIÓN</MudText>
        <MudNavMenu Dense="true">
            <MudNavLink Href="socios" Icon="@Icons.Material.Filled.Group">
                Socios
            </MudNavLink>
            <MudNavLink Href="planes" Icon="@Icons.Material.Filled.LibraryBooks">
                Planes
            </MudNavLink>
        </MudNavMenu>

    </MudDrawer>

    <!-- CONTENIDO -->
    <MudMainContent Class="pt-16">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-0">
            @Body
        </MudContainer>
    </MudMainContent>

</MudLayout>


@code {
    private bool _open = false;

    private void ToggleDrawer()
    {
        _open = !_open;
    }
}