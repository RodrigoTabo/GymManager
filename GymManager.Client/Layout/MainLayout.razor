@inject GymManager.Web.Security.JwtAuthStateProvider JwtAuthStateProvider
@inject GymManager.Web.Security.ApiHttpClientProvider ApiHttpClientProvider
@inject NavigationManager Navigation
@inherits LayoutComponentBase

<MudThemeProvider />
<MudDialogProvider />
<MudPopoverProvider />
<MudSnackbarProvider />

<MudAppBar Elevation="4" Color="Color.Primary" Dense="true">
    <MudText Typo="Typo.h6" Class="white-text mx-4">GymManager</MudText>
</MudAppBar>

<MudLayout>
    <MudDrawer Open="true"
               Anchor="Anchor.Left"
               Variant="DrawerVariant.Persistent"
               Elevation="2"
               Width="260px"
               Class="pt-16 d-flex flex-column mud-theme-background">

        <!-- Logo -->
        <MudDrawerHeader Class="pb-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h6" Class="font-weight-bold">GymManager</MudText>
            </MudStack>
        </MudDrawerHeader>

        <!-- Secciones -->
        <MudText Typo="Typo.caption" Class="px-3 mt-5 mb-2 mud-text-secondary font-weight-bold">DASHBOARD</MudText>
        <MudNavMenu Dense="true">
            <MudNavLink Href="/general" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                General
            </MudNavLink>
            <MudNavLink Href="/asistencias" Icon="@Icons.Material.Filled.FactCheck">
                Asistencias
            </MudNavLink>
        </MudNavMenu>

        <MudText Typo="Typo.caption" Class="px-3 mt-5 mb-2 mud-text-secondary font-weight-bold">REPORTES</MudText>
        <MudNavMenu Dense="true">
            <MudNavLink Href="/registro-de-accesos" Icon="@Icons.Material.Filled.Login">
                Registro de Accesos
            </MudNavLink>
        </MudNavMenu>

        <MudText Typo="Typo.caption" Class="px-3 mt-5 mb-2 mud-text-secondary font-weight-bold">COBRANZAS</MudText>
        <MudNavMenu Dense="true">
            <MudNavLink Href="/control-de-pagos" Icon="@Icons.Material.Filled.Payments">
                Control de Pagos
            </MudNavLink>
        </MudNavMenu>

        <MudText Typo="Typo.caption" Class="px-3 mt-5 mb-2 mud-text-secondary font-weight-bold">ADMINISTRACIÓN</MudText>
        <MudNavMenu Dense="true">
            <MudNavLink Href="/socios" Icon="@Icons.Material.Filled.Group">
                Socios
            </MudNavLink>
            <MudNavLink Href="/panel-administrativo" Icon="@Icons.Material.Filled.Settings">
                Panel Administrativo
            </MudNavLink>
        </MudNavMenu>

        <MudSpacer />

        <!-- Botones de acción -->
        <MudStack Class="pa-2 pt-1" Spacing="1">
            <MudButton OnClick="CambiarSucursal"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.SyncAlt">
                Cambiar sucursal
            </MudButton>

            <MudButton OnClick="Logout"
                       Variant="Variant.Outlined"
                       Color="Color.Error"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Logout">
                Salir
            </MudButton>
        </MudStack>
    </MudDrawer>

    <MudMainContent Class="pt-16">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-0">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private Guid? CurrentSucursalId => TryGetSucursalIdFromUrl();

    private Guid? TryGetSucursalIdFromUrl()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var segments = relativePath.Split('/', StringSplitOptions.RemoveEmptyEntries);

        if (segments.Length >= 2 &&
            segments[0].Equals("sucursal", StringComparison.OrdinalIgnoreCase) &&
            Guid.TryParse(segments[1], out var sucursalId))
        {
            return sucursalId;
        }

        return null;
    }

    private void CambiarSucursal()
    {
        Navigation.NavigateTo("/sucursales");
    }

    private async Task Logout()
    {
        await JwtAuthStateProvider.MarkUserAsLoggedOutAsync();
        ApiHttpClientProvider.ClearAuthorization();
        Navigation.NavigateTo("/login");
    }
}