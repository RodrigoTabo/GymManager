@inject GymManager.Web.Security.JwtAuthStateProvider JwtAuthStateProvider
@inject GymManager.Web.Security.ApiHttpClientProvider ApiHttpClientProvider
@inject NavigationManager Navigation
@inherits LayoutComponentBase

<MudThemeProvider />
<MudDialogProvider />
<MudPopoverProvider />
<MudSnackbarProvider />

<MudAppBar Elevation="1" Dense="true">
</MudAppBar>

<MudLayout>
    <MudDrawer Open="true"
               Anchor="Anchor.Left"
               Variant="DrawerVariant.Persistent"
               Elevation="1"
               Width="260px"
               Class="pt-16 d-flex flex-column">

        <MudDrawerHeader Class="pb-1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Color="Color.Primary" />
                <MudText Typo="Typo.h6">GymManager</MudText>
            </MudStack>
        </MudDrawerHeader>

        <MudText Typo="Typo.caption" Class="px-3 mt-5 mb-1 mud-text-secondary">DASHBOARD</MudText>
        <MudNavMenu Dense="true">
            <MudNavLink Href="@($"/sucursal/{CurrentSucursalId}/general")"
                        Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.Dashboard">
                General
            </MudNavLink>
            <MudNavLink Href="@($"/sucursal/{CurrentSucursalId}/asistencia")"
                        Icon="@Icons.Material.Filled.FactCheck">
                Asistencias
            </MudNavLink>
        </MudNavMenu>

        <MudText Typo="Typo.caption" Class="px-3 mt-5 mb-1 mud-text-secondary">REPORTES</MudText>
        <MudNavMenu Dense="true">
            <MudNavLink Href="@($"/sucursal/{CurrentSucursalId}/registro-de-accesos")"
                        Icon="@Icons.Material.Filled.Login">
                Registro de Accesos
            </MudNavLink>
        </MudNavMenu>

        <MudText Typo="Typo.caption" Class="px-3 mt-5 mb-1 mud-text-secondary">COBRANZAS</MudText>
        <MudNavMenu Dense="true">
            <MudNavLink Href="@($"/sucursal/{CurrentSucursalId}/control-de-pagos")"
                        Icon="@Icons.Material.Filled.Payments">
                Control de Pagos
            </MudNavLink>
        </MudNavMenu>

        <MudText Typo="Typo.caption" Class="px-3 mt-5 mb-1 mud-text-secondary">ADMINISTRACIÓN</MudText>
        <MudNavMenu Dense="true">
            <MudNavLink Href="@($"/sucursal/{CurrentSucursalId}/socios")"
                        Icon="@Icons.Material.Filled.Group">
                Socios
            </MudNavLink>
            <MudNavLink Href="@($"/sucursal/{CurrentSucursalId}/panel-administrativo")"
                        Icon="@Icons.Material.Filled.Settings">
                Panel Administrativo
            </MudNavLink>
        </MudNavMenu>

        <MudSpacer />

        <MudStack Class="pa-2 pt-1" Spacing="0">
            <MudButton OnClick="CambiarSucursal"
                       Variant="Variant.Text"
                       Color="Color.Primary"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.SyncAlt">
                Cambiar sucursal
            </MudButton>

            <MudButton OnClick="Logout"
                       Variant="Variant.Text"
                       Color="Color.Error"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Logout">
                Salir
            </MudButton>
        </MudStack>
    </MudDrawer>

    <MudMainContent Class="pt-16">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-0">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private Guid? CurrentSucursalId => TryGetSucursalIdFromUrl();

    private Guid? TryGetSucursalIdFromUrl()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var segments = relativePath.Split('/', StringSplitOptions.RemoveEmptyEntries);

        if (segments.Length >= 2 &&
            segments[0].Equals("sucursal", StringComparison.OrdinalIgnoreCase) &&
            Guid.TryParse(segments[1], out var sucursalId))
        {
            return sucursalId;
        }

        return null;
    }

    private void CambiarSucursal()
    {
        Navigation.NavigateTo("/sucursales");
    }

    private async Task Logout()
    {
        await JwtAuthStateProvider.MarkUserAsLoggedOutAsync();
        ApiHttpClientProvider.ClearAuthorization();
        Navigation.NavigateTo("/login");
    }
}