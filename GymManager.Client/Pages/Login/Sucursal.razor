@page "/sucursales"
@layout AuthLayout
@attribute [Authorize]
@using GymManager.Client.ApiClients
@using GymManager.Shared.Contracts.Sucursal
@using GymManager.Web.ApiClients
@using GymManager.Web.Security
@using Microsoft.AspNetCore.Authorization
@inject GymManager.Web.Security.JwtAuthStateProvider JwtAuthStateProvider
@inject GymManager.Web.Security.ApiHttpClientProvider ApiHttpClientProvider
@inject NavigationManager Navigation
@inject SucursalApi SucursalApi
@inject AuthApi AuthApi

<MudContainer MaxWidth="MaxWidth.False"
              Class="pa-0 d-flex flex-column align-center justify-center"
              Style="min-height: 75vh; gap:16px;">

    <MudPaper Elevation="6"
              Class="pa-6"
              Style="width: 100%; max-width: 620px; border-radius: 5px;">

        <MudStack Spacing="3">

            <MudStack Spacing="0" Class="mb-2">
                <MudText Typo="Typo.h4">Seleccionar sucursal</MudText>
                <MudText Typo="Typo.body2" Color="Color.Primary">
                    Elegí la sucursal con la que querés trabajar.
                </MudText>
            </MudStack>

            @foreach (var sucursal in Sucursales)
            {
                <MudPaper Outlined="true" Class="pa-4" Elevation="2">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        
                        <MudStack Spacing="0">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Store" Color="Color.Primary" />
                                <MudText Typo="Typo.h6">@sucursal.Nombre</MudText>
                            </MudStack>

                            <MudText Typo="Typo.body2" Color="Color.Primary">
                                Ingresá a esta sucursal para gestionar socios, pagos y asistencia.
                            </MudText>
                        </MudStack>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="() => Acceder(sucursal.Id)">
                            Acceder
                        </MudButton>

                    </MudStack>
                </MudPaper>
            }

            <MudButton OnClick="Logout"
                       Variant="Variant.Filled"
                       Color="Color.Error"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Logout">
                Salir
            </MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {

    private List<SucursalResponse> Sucursales { get; set; } = new();
    private string? Error;
    private bool Loading;

    protected override async Task OnInitializedAsync()
    => await LoadSucursalesAsync();

    private async Task Logout()
    {
        await JwtAuthStateProvider.MarkUserAsLoggedOutAsync();
        ApiHttpClientProvider.ClearAuthorization();
        Navigation.NavigateTo("/login");
    }

    private async Task LoadSucursalesAsync()
    {
        Loading = true;

        try
        {
            Sucursales = await SucursalApi.Get();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Loading = false;
        }

    }

    private async Task Acceder(Guid sucursalId)
    {
        Loading = true;
        Error = null;

        try
        {
            var result = await AuthApi.SelectBranchAsync(sucursalId.ToString());

            await JwtAuthStateProvider.MarkUserAsAuthenticatedAsync(result.Token);

            // 3. Navegamos al panel general
            Navigation.NavigateTo("/general");
        }
        catch (Exception ex)
        {
            Error = "Error al conectar con la sucursal: " + ex.Message;
        }
        finally
        {
            Loading = false;
        }
    }


}
