@page "/login"
@using Microsoft.AspNetCore.Authorization
@using GymManager.Shared.Auth
@attribute [AllowAnonymous]

@inject GymManager.Web.ApiClients.AuthApi AuthApi
@inject GymManager.Web.Security.JwtAuthStateProvider JwtAuthStateProvider
@inject NavigationManager Navigation

<h3>Login</h3>

<div class="mb-2">
    <label>Email</label>
    <input @bind="model.Email" />
</div>

<div class="mb-2">
    <label>Password</label>
    <input type="password" @bind="model.Password" />
</div>

<button @onclick="HandleLogin">Ingresar</button>

@if (!string.IsNullOrWhiteSpace(error))
{
    <p>@error</p>
}

@code {
    private LoginRequest model = new();
    private string? error;

    private async Task HandleLogin()
    {
        try
        {
            error = null;

            var result = await AuthApi.LoginAsync(model);

            await JwtAuthStateProvider.MarkUserAsAuthenticatedAsync(result.AccessToken);

            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}