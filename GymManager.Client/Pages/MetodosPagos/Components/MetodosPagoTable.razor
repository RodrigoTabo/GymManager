@using GymManager.Shared.Contracts.MetodoPago
<MudTable Items="@Items"
          Hover="true"
          Dense="true"
          Striped="true"
          Breakpoint="Breakpoint.None"
          Loading="@Loading"
          LoadingProgressColor="Color.Info"
          HorizontalScrollbar="true"
          Elevation="0">


    <HeaderContent>
        <MudTh>Nombre</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="MetodoPago">
            @if (context.Nombre == "Transferencia")
            {
                <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Class="me-1" />
                <span>@context.Nombre</span>
            }
            else if (context.Nombre == "Efectivo")
            {
                <MudIcon Icon="@Icons.Material.Filled.Payments" Class="me-1" />
                <span>@context.Nombre</span>
            }
            else if (context.Nombre == "debito")
            {
                <MudIcon Icon="@Icons.Material.Filled.Payments" Class="me-1" />
                <span>@context.Nombre</span>
            }
            else if (context.Nombre == "credito")
            {
                <MudIcon Icon="@Icons.Material.Filled.Payments" Class="me-1" />
                <span>@context.Nombre</span>
            }else
            {
                <span>@context.Nombre</span>
            }
        </MudTd>
    </RowTemplate>

    <NoRecordsContent>
        <MudStack Class="pa-6" AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" />
            <MudText Typo="Typo.body1">No hay intentos de accesos para mostrar</MudText>
            <MudText Typo="Typo.caption">Probá cambiando los filtros.</MudText>
        </MudStack>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
    </PagerContent>

</MudTable>

@code {

    [Parameter]
    public List<MetodoPagoResponse> Items { get; set; } = new();
    [Parameter]
    public bool Loading { get; set; }

}
