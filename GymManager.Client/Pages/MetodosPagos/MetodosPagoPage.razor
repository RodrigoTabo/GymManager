@using GymManager.Client.ApiClients
@using GymManager.Client.Pages.MetodosPagos.Components
@using GymManager.Shared.Contracts.MetodoPago
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject MetodoPagoApi MetodoPagoApi

    <!--Table-->
<MudStack Row="true"
          AlignItems="AlignItems.Center"
          Justify="Justify.SpaceBetween"
          Class="mb-4">


        <MudStack Spacing="0">
            <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Class="me-1" />
            Métodos de pagos
        </MudText>
        </MudStack>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Disabled="@(loading)"
                   OnClick="ReloadAsync">
            Nuevo método
        </MudButton>
    </MudStack>

<MudDivider></MudDivider>
    <MetodosPagoTable Items="@metodoPagoResponse"
                      Loading="@loading" />


@code {
    [Parameter]
    public Guid SucursalId { get; set; }

    private List<MetodoPagoResponse> metodoPagoResponse = new();
    private bool loading;


    protected override async Task OnInitializedAsync()
    => await ReloadAsync();

    private async Task ReloadAsync()
    {
        await LoadMetodosPagoAsync();
    }

    private async Task LoadMetodosPagoAsync()
    {
        loading = true;

        try
        {
            metodoPagoResponse = await MetodoPagoApi.ListarAsync(SucursalId);
        }
        finally
        {
            loading = false;
        }
    }

}
