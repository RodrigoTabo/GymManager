@attribute [Authorize]
@using MudBlazor
@using GymManager.Client.ApiClients
@using GymManager.Client.Pages.Pagos.Components
@using GymManager.Shared.Contracts.Pagos
@using GymManager.Shared.Contracts.Socios
@using Microsoft.AspNetCore.Authorization
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject PagoApi PagoApi

<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto pa-0">

    @if (!string.IsNullOrWhiteSpace(ErrorStats))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">@ErrorStats</MudAlert>
    }

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">@Error</MudAlert>
    }

    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius:18px;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h5">Vencimientos</MudText>
                <MudText Color="Color.Primary" Typo="Typo.subtitle2">Historial de socios que vencieron y vencerán</MudText>
            </MudStack>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius:18px;">
        <VencidoTable Items="Items"
                      Loading="Loading"
                      OnWhatsApp="MensajeWhatsapp"
                      OnPago="OpenPago" />
    </MudPaper>

    <VencimientosStatsSection Loading="loadingStats"
                              Stats="Stats" />

</MudContainer>

@code {

    private List<VencidoResponse> Items = new();
    private VencimientoStatsResponse Stats = new();

    private bool loadingStats;
    private bool Loading;

    private string? Error;
    private string? ErrorStats;

    protected override Task OnInitializedAsync()
     => ReloadAsync();

    private async Task ReloadAsync()
    {
        await LoadVencidosAsync();
        await LoadStatsAsync();
    }

    public async Task LoadVencidosAsync()
    {
        Loading = true;
        Error = null;

        try
        {
            Items = await PagoApi.GetVencidosAsync();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Loading = false;
        }
    }

    public async Task MensajeWhatsapp(VencidoResponse items)
    {
        var hoy = DateTime.Today;
        var vencimiento = items.VenceEn.Date;

        string mensaje = vencimiento == hoy
                 ? $"Hola {items.NombreCompleto}, te recordamos que tu plan vence hoy. Si querés renovarlo, escribinos."
                 : $"Hola {items.NombreCompleto}, te recordamos que tu plan vence esta semana. Si querés renovarlo, escribinos.";

        var telefono = items.Telefono;
        var url = $"https://wa.me/{telefono}?text={Uri.EscapeDataString(mensaje)}";

        await JS.InvokeVoidAsync("open", url, "_blank");

    }

    public async Task LoadStatsAsync()
    {
        loadingStats = true;
        ErrorStats = null;

        try
        {
            Stats = await PagoApi.GetVencimientoStatsAsync();
        }
        catch (Exception ex)
        {
            ErrorStats = ex.Message;
        }
        finally
        {
            loadingStats = false;
        }
    }

    private async Task OpenPago(VencidoResponse vencido)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var parameters = new DialogParameters
        {
            ["SocioId"] = vencido.SocioId,
            ["SocioNombre"] = $"{vencido.NombreCompleto}"
        };

        var dialog = await DialogService.ShowAsync<PagoDialog>("Agregar Pago", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
            await ReloadAsync();
    }
}
