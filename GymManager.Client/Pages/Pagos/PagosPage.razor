@page "/pagos"
@using GymManager.Client.ApiClients
@using GymManager.Client.Pages.Pagos.Components
@using GymManager.Shared.Contracts.Pagos
@using MudBlazor.Charts
@inject PagoApi PagoApi
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto pa-0">

    <!-- Header -->
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h5">Gestionar Pagos</MudText>
                <MudText Typo="Typo.body2" Color="Color.Primary">Alta, edición, baja de Pagos</MudText>
            </MudStack>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@(loading || loadingStats)"
                       OnClick="ReloadAsync">
                Refrescar
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (!string.IsNullOrWhiteSpace(errorStats))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">@errorStats</MudAlert>
    }

    @if (!string.IsNullOrWhiteSpace(errorPagos))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">@errorPagos</MudAlert>
    }

    <!-- KPI Cards -->
    <MudGrid Spacing="2" Class="mb-4">

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Outlined="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudAvatar Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" />
                    </MudAvatar>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2">Pagos del mes</MudText>
                        <MudText Typo="Typo.h4">@(loadingStats ? "—" : stats.PagosMensualesCount.ToString("N0"))</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Outlined="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudAvatar Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.Event" />
                    </MudAvatar>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2">Pagos de hoy</MudText>
                        <MudText Typo="Typo.h4">@(loadingStats ? "—" : stats.PagosDiariosCount.ToString("N0"))</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Outlined="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudAvatar Variant="Variant.Filled" Color="Color.Success" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.AttachMoney" />
                    </MudAvatar>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2">Total del mes</MudText>
                        <MudText Typo="Typo.h4">@(loadingStats ? "—" : stats.TotalPagoMensual.ToString("N2"))</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Outlined="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudAvatar Variant="Variant.Filled" Color="Color.Info" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.Payments" />
                    </MudAvatar>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2">Total de hoy</MudText>
                        <MudText Typo="Typo.h4">@(loadingStats ? "—" : stats.TotalPagoDiario.ToString("N2"))</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Outlined="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudAvatar Variant="Variant.Filled" Color="Color.Warning" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.LocalAtm" />
                    </MudAvatar>

                    <MudStack Spacing="0" Class="flex-grow-1">
                        <MudText Typo="Typo.subtitle2">Efectivo (hoy)</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Baseline" JustifyContent="Justify.SpaceBetween">
                            <MudText Typo="Typo.h5">@(loadingStats ? "—" : stats.PagosDiariosEnEfectivo.ToString("N0")) pagos</MudText>
                            <MudText Typo="Typo.h5">@(loadingStats ? "—" : stats.TotalDiariosPagoEfectivo.ToString("N2"))</MudText>
                        </MudStack>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Outlined="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudAvatar Variant="Variant.Filled" Color="Color.Tertiary" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" />
                    </MudAvatar>

                    <MudStack Spacing="0" Class="flex-grow-1">
                        <MudText Typo="Typo.subtitle2">Transferencia (hoy)</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Baseline" JustifyContent="Justify.SpaceBetween">
                            <MudText Typo="Typo.h5">@(loadingStats ? "—" : stats.PagosDiariosEnTransferencia.ToString("N0")) pagos</MudText>
                            <MudText Typo="Typo.h5">@(loadingStats ? "—" : stats.TotalDiariosPagoTransferencia.ToString("N2"))</MudText>
                        </MudStack>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- GRÁFICOS -->
    <MudGrid Spacing="2" Class="mb-4">
        <!-- Total por mes (full width) -->
        <MudItem xs="12">
            <MudPaper Class="pa-4" Outlined="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.h6">Total por mes (últimos 6)</MudText>
                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">
                        @(loadingStats ? "—" : stats.TotalPorMes.Sum(x => x.Total).ToString("N2"))
                    </MudChip>
                </MudStack>

                @if (loadingStats)
                {
                    <MudProgressLinear Indeterminate="true" Class="mt-4" />
                }
                else
                {
                    <MudChart T="double"
                              ChartType="ChartType.Bar"
                              ChartSeries="@barSeries"
                              XAxisLabels="@barLabels"
                              Height="260px" />
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- Tabla de Pagos -->
    <MudPaper Class="pa-0" Elevation="1">
        <PagoTable Items="@pagos"
                   Loading="@loading"
                   OnDelete="ConfirmDelete"
                   OnEdit="OpenEdit" />
    </MudPaper>

</MudContainer>

@code {
    private List<PagoResponse> pagos = new();

    private PagosStatsResponse stats = new()
    {
        TotalPorMes = new List<PagoMesSerie>()
    };

    private bool loadingStats;
    private bool loading;

    private string? errorStats;
    private string? errorPagos;

    private List<ChartSeries<double>> barSeries = new();
    private string[] barLabels = Array.Empty<string>();


    protected override async Task OnInitializedAsync()
        => await ReloadAsync();

    private async Task ReloadAsync()
    {
        await LoadPagosAsync();
        await LoadStatsAsync();
    }

    private async Task LoadPagosAsync()
    {
        loading = true;
        errorPagos = null;

        try
        {
            pagos = await PagoApi.ListarAsync();
        }
        catch (Exception ex)
        {
            errorPagos = ex.Message;
            pagos = new();
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadStatsAsync()
    {
        loadingStats = true;
        errorStats = null;

        try
        {
            stats = await PagoApi.GetPagosStatsAsync();

            BuildBarChart();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorStats = ex.Message;
            stats = new() { TotalPorMes = new List<PagoMesSerie>() };

            barSeries = new();
            barLabels = Array.Empty<string>();
        }
        finally
        {
            loadingStats = false;
        }
    }

    private async Task OpenEdit(PagoResponse pago)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var parameters = new DialogParameters { ["Pago"] = pago };

        var dialog = await DialogService.ShowAsync<UpdatePagoDialog>("Editar Pago", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
            await ReloadAsync();
    }

    private async Task ConfirmDelete(PagoResponse pago)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var parameters = new DialogParameters
        {
            ["Pago"] = pago,
            ["ContentText"] = $"¿Seguro que querés eliminar el pago del Socio \"{pago.Socio}\"?",
            ["ButtonText"] = "Eliminar",
            ["Color"] = Color.Error
        };

        var dialog = await DialogService.ShowAsync<PagoDialogDelete>("Eliminar Pago", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
            await ReloadAsync();
    }

    private void BuildBarChart()
    {
        var serie = stats.TotalPorMes ?? new List<PagoMesSerie>();

        barLabels = serie.Select(x => FormatMes(x.Mes)).ToArray();

        barSeries = new List<ChartSeries<double>>
        {
            new ChartSeries<double>
            {
                Name = "Total",
                Data = serie.Select(x => (double)x.Total).ToArray()
            }
        };
    }

    private static string FormatMes(string mes)
    {
        // Espera "yyyy-MM"
        if (!string.IsNullOrWhiteSpace(mes) &&
            mes.Length == 7 &&
            int.TryParse(mes.Substring(0, 4), out var y) &&
            int.TryParse(mes.Substring(5, 2), out var m) &&
            m is >= 1 and <= 12)
        {
            return new DateTime(y, m, 1).ToString("MMM");
        }

        return mes ?? "";
    }
}