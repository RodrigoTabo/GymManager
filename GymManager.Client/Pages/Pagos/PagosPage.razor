@page "/sucursal/{SucursalId:guid}/pagos"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using GymManager.Client.ApiClients
@using GymManager.Client.Pages.Pagos.Components
@using GymManager.Shared.Contracts.Pagos
@using MudBlazor.Charts
@inject PagoApi PagoApi
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto pa-0">

    @if (!string.IsNullOrWhiteSpace(errorStats))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">@errorStats</MudAlert>
    }

    @if (!string.IsNullOrWhiteSpace(errorPagos))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">@errorPagos</MudAlert>
    }

    <!-- KPI Cards + Graficos + Tabla -->

    <PagoStatsSection Stats="Stats"
                      Loading="loadingStats" />
    <br />

    <MudPaper Class="pa-4 mb-4" Elevation="5">

        <!-- Ya tenemos separado una sección para un futuro filtro. -->
        <PagoFiltersSection LoadingStats="loadingStats"
                            Loading="loading"
                            ReloadAsync="ReloadAsync" />

        <MudDivider></MudDivider>

        <PagoTable Items="@pagos"
                   Loading="@loading"
                   OnDelete="ConfirmDelete"
                   OnEdit="OpenEdit" />

    </MudPaper>


</MudContainer>

@code {

    [Parameter]
    public Guid SucursalId { get; set; }
    private List<PagoResponse> pagos = new();

    private PagosStatsResponse Stats = new()
    {
        TotalPorMes = new List<PagoMesSerie>()
    };

    private bool loadingStats;
    private bool loading;

    private string? errorStats;
    private string? errorPagos;


    protected override async Task OnInitializedAsync()
        => await ReloadAsync();

    private async Task ReloadAsync()
    {
        await LoadPagosAsync();
        await LoadStatsAsync();
    }

    private async Task LoadPagosAsync()
    {
        loading = true;
        errorPagos = null;

        try
        {
            pagos = await PagoApi.ListarAsync(SucursalId);
        }
        catch (Exception ex)
        {
            errorPagos = ex.Message;
            pagos = new();
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadStatsAsync()
    {
        loadingStats = true;
        errorStats = null;

        try
        {
            Stats = await PagoApi.GetPagosStatsAsync(SucursalId);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorStats = ex.Message;
            Stats = new() { TotalPorMes = new List<PagoMesSerie>() };
        }
        finally
        {
            loadingStats = false;
        }
    }

    private async Task OpenEdit(PagoResponse pago)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var parameters = new DialogParameters
        {
            ["Pago"] = pago,
            ["SucursalId"] = SucursalId
        };

        var dialog = await DialogService.ShowAsync<UpdatePagoDialog>("Editar Pago", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
            await ReloadAsync();
    }

    private async Task ConfirmDelete(PagoResponse pago)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var parameters = new DialogParameters
        {
            ["Pago"] = pago,
            ["ContentText"] = $"¿Seguro que querés eliminar el pago del Socio \"{pago.Socio}\"?",
            ["ButtonText"] = "Eliminar",
            ["Color"] = Color.Error,
            ["SucursalId"] = SucursalId
        };

        var dialog = await DialogService.ShowAsync<PagoDialogDelete>("Eliminar Pago", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
            await ReloadAsync();
    }

}