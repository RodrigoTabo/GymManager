@using GymManager.Shared.Contracts.Pagos
@using MudBlazor
<MudTable Items="@Items"
          Hover="true"
          Dense="true"
          Breakpoint="Breakpoint.None"
          Loading="@Loading"
          LoadingProgressColor="Color.Info"
          HorizontalScrollbar="true"
          Elevation="0">


    <HeaderContent>
        <MudTh>Socio</MudTh>
        <MudTh>Fecha de Pago</MudTh>
        <MudTh>Importe</MudTh>
        <MudTh>MetodoPago</MudTh>
        <MudTh>Cubre Desde</MudTh>
        <MudTh>Cubre Hasta</MudTh>
        <MudTh>Acciones</MudTh>
    </HeaderContent>


    <RowTemplate>
        <MudTd DataLabel="Socio">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudAvatar Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                </MudAvatar>
                <MudTd DataLabel="Socio">@context.Socio</MudTd>
            </MudStack>
        </MudTd>
        <MudTd DataLabel="Fecha de Pago">@context.FechaPago</MudTd>      
        <MudTd DataLabel="Importe">@context.Importe</MudTd>

        <MudTd DataLabel="MetodoPago">
            <MudText Typo="Typo.body2">@context.MetodoPago</MudText>
        </MudTd>



        <MudTd DataLabel="Alta">
            <MudChip T="string"
                     Size="Size.Small"
                     Variant="Variant.Filled"
                     Color="Color.Success">
                @context.CubreDesde
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Alta">
            <MudChip T="string"
                     Size="Size.Small"
                     Variant="Variant.Filled"
                     Color="Color.Error">
                @context.CubreHasta
            </MudChip>
        </MudTd>

        <MudTd DataLabel="Acciones">
            <MudStack Row="true" Spacing="1">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                               OnClick="@(() => OnEdit.InvokeAsync(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                               OnClick="@(() => OnDelete.InvokeAsync(context))" />
            </MudStack>
        </MudTd>
    </RowTemplate>


    <NoRecordsContent>
        <MudStack Class="pa-6" AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" />
            <MudText Typo="Typo.body1">No hay socios para mostrar</MudText>
            <MudText Typo="Typo.caption">Probá cambiando los filtros.</MudText>
        </MudStack>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
    </PagerContent>
</MudTable>

@code {

    [Parameter]
    public List<PagoResponse> Items { get; set; } = new();
    [Parameter]
    public bool Loading { get; set; }

    [Parameter] public EventCallback<PagoResponse> OnEdit { get; set; }
    [Parameter] public EventCallback<PagoResponse> OnDelete { get; set; }
    [Parameter] public EventCallback<PagoResponse> OnPago { get; set; }

}
