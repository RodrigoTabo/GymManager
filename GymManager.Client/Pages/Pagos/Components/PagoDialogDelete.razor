@using GymManager.Client.ApiClients
@using GymManager.Shared.Contracts.Pagos
@inject PagoApi PagoApi

<MudDialog>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <MudAlert Severity="Severity.Error">@Error</MudAlert>
        }
        <MudText>@ContentText</MudText>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@Guardando">Cancelar</MudButton>

        <MudButton Color="@Color"
                   Variant="Variant.Filled"
                   OnClick="Delete"
                   Disabled="@Guardando">
            @ButtonText
        </MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string ContentText { get; set; } = "";
    [Parameter]
    public string ButtonText { get; set; } = "Confirmar";
    [Parameter]
    public Color Color { get; set; } = Color.Primary;


    [Parameter]
    public PagoResponse? Pago { get; set; }

    private string? Error;
    private bool Guardando;

    public async Task Delete()
    {
        Error = null;

        if (Pago is null || Pago.Id <= 0)
        {
            Error = "El Pago no existe.";
            return;
        }

        Guardando = true;

        try
        {
            await PagoApi.SoftDeleteAsync(Pago.Id);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Guardando = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

}
