@using GymManager.Client.Components
@using GymManager.Shared.Contracts.Pagos


<MudGrid Spacing="3" Class="mb-4">

    <MudItem xs="12" sm="6" md="3">
        <KpiCard Titulo="Vencen hoy"
                 Valor="@(Stats.VencenHoy.ToString("N0"))"
                 Loading="@Loading"
                 Icon="@Icons.Material.Filled.MoneyOff"
                 Color="Color.Error" />
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <KpiCard Titulo="Vencen esta semana"
                 Valor="@(Stats.VencenEstaSemana.ToString("N0"))"
                 Loading="@Loading"
                 Icon="@Icons.Material.Filled.MoneyOff"
                 Color="Color.Warning" />
    </MudItem>
  
    <MudItem xs="12" sm="6" md="3">
        <KpiCard Titulo="Total abono diario"
                 Valor="@(Stats.TotalCobrarHoy.ToString("N0"))"
                 Loading="@Loading"
                 Icon="@Icons.Material.Filled.AttachMoney"
                 Color="Color.Success" />
    </MudItem>

    
    <MudItem xs="12" sm="6" md="3">
        <KpiCard Titulo="Total abono semanal"
                 Valor="@(Stats.TotalCobrarSemana.ToString("N0"))"
                 Loading="@Loading"
                 Icon="@Icons.Material.Filled.MonetizationOn"
                 Color="Color.Info" />
    </MudItem>
    
    <MudItem xs="12" sm="6" md="3">
        <KpiCard Titulo="Cantidad de vencidos"
                 Valor="@(Stats.Vencidos.ToString("N0"))"
                 Loading="@Loading"
                 Icon="@Icons.Material.Filled.PersonOff"
                 Color="Color.Error" />
    </MudItem>
</MudGrid>

@code {

    [Parameter]
    public VencimientoStatsResponse Stats { get; set; } = new();

    [Parameter]
    public bool Loading { get; set; }
}
