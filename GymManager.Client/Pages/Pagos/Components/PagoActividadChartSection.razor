@using GymManager.Shared.Contracts.Pagos


<MudItem xs="12" lg="5">
    <MudPaper Class="pa-4" Elevation="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.h6">Recaudación por mes (últimos 6)</MudText>
            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">
                @(Loading ? "—" : Stats.TotalPorMes.Sum(x => x.Total).ToString("N2"))
            </MudChip>
        </MudStack>

        @if (Loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <MudChart T="double"
                      ChartType="ChartType.Line"
                      ChartSeries="@barSeries"
                      XAxisLabels="@barLabels"
                      Height="260px" />
        }
    </MudPaper>
</MudItem>

@code {

    [Parameter]
    public PagosStatsResponse Stats { get; set; } = new();
    [Parameter]
    public bool Loading { get; set; }

    private List<ChartSeries<double>> barSeries = new();
    private string[] barLabels = Array.Empty<string>();

    protected override void OnParametersSet()
    {
        BuildBarChart();
    }

    private static string FormatMes(string mes)
    {
        // Espera "yyyy-MM"
        if (!string.IsNullOrWhiteSpace(mes) &&
            mes.Length == 7 &&
            int.TryParse(mes.Substring(0, 4), out var y) &&
            int.TryParse(mes.Substring(5, 2), out var m) &&
            m is >= 1 and <= 12)
        {
            return new DateTime(y, m, 1).ToString("MMM");
        }

        return mes ?? "";
    }

    private void BuildBarChart()
    {
        var serie = Stats.TotalPorMes ?? new List<PagoMesSerie>();

        barLabels = serie.Select(x => FormatMes(x.Mes)).ToArray();

        barSeries = new List<ChartSeries<double>>
        {
            new ChartSeries<double>
            {
                Name = "Total",
                Data = serie.Select(x => (double)x.Total).ToArray()
            }
        };
    }

}
