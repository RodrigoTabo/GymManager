@page "/socios"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using MudBlazor
@using GymManager.Client.ApiClients
@using GymManager.Shared.Contracts.Socios
@inject IDialogService DialogService
@inject SocioApi SocioApi

<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto pa-0">
    
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius:5px;">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        
            <MudStack Spacing="0">
                <MudText Typo="Typo.h5">Gestionar Socios</MudText>
                <MudText Color="Color.Primary" Typo="Typo.subtitle2">
                    Gestiona los socios de la sucursal (Alta, baja y pago del plan asignado).
                </MudText>
            </MudStack>
            <MudButton OnClick="OpenCrear"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AddBox">
                Agregar socio
            </MudButton>
        </MudStack>
    </MudPaper>


    <!-- Barra de filtro -->
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius:5px;">
        <SocioFiltersSection Filtro="@Filtro"
                             OnFiltroChanged="HandleFiltroChanged"
                             OnCrear="OpenCrear" />
    </MudPaper>

    <!-- Tabla -->
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius:5px;">
        <SocioTable Items="@socios"
                    Loading="@loading"
                    OnEdit="OpenEdit"
                    OnDelete="ConfirmDelete"
                    OnPago="OpenPago" />
    </MudPaper>



    <!-- KPI Cards + Paneles -->
    <SocioStatsSection Stats="@Stats"
                       Loading="@loadingStats" />
</MudContainer>

@code {

    private List<SocioResponse> socios = new();
    private SociosStatsResponse Stats { get; set; } = new();

    private bool loadingStats;
    private bool loading;

    private SocioQuery Filtro { get; set; } = new SocioQuery
    {
        BuscarPor = "NombreCompleto",
        Texto = "",
        Inactivo = false
    };

    protected override async Task OnInitializedAsync()
        => await ReloadAsync();

    private async Task ReloadAsync()
    {
        await LoadStatsAsync();
        await LoadSociosAsync();
    }

    private async Task LoadSociosAsync()
    {
        loading = true;
        try
        {
            socios = await SocioApi.ListarAsync( Filtro);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadStatsAsync()
    {
        loadingStats = true;
        try
        {
            Stats = await SocioApi.GetStatsAsync();
        }
        finally
        {
            loadingStats = false;
        }
    }

    private async Task OpenCrear()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<SocioDialog>("Crear Socio", options);
        var result = await dialog.Result;

        if (!result.Canceled)
            await ReloadAsync();
    }

    private async Task OpenEdit(SocioResponse socio)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var parameters = new DialogParameters
        {
            ["Socio"] = socio,
        };

        var dialog = await DialogService.ShowAsync<SocioDialog>("Editar Socio", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
            await ReloadAsync();
    }

    private async Task OpenPago(SocioResponse socio)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var parameters = new DialogParameters
        {
            ["Socio"] = socio,
            ["SocioNombre"] = $"{socio.Nombre} {socio.Apellido}"
        };

        var dialog = await DialogService.ShowAsync<PagoDialog>("Agregar Pago", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
            await ReloadAsync();
    }

    private async Task ConfirmDelete(SocioResponse socio)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var parameters = new DialogParameters
        {
            ["Socio"] = socio,
            ["ContentText"] = $"¿Seguro que querés eliminar el Socio \"{socio.Nombre} {socio.Apellido}\"?",
            ["ButtonText"] = "Eliminar",
            ["Color"] = Color.Error
        };

        var dialog = await DialogService.ShowAsync<SocioDialogDelete>("Eliminar Socio", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
            await ReloadAsync();
    }

    private async Task HandleFiltroChanged(SocioQuery nuevo)
    {
        Filtro = new SocioQuery
        {
            BuscarPor = nuevo.BuscarPor,
            Texto = nuevo.Texto,
            Inactivo = nuevo.Inactivo
        };

        await LoadSociosAsync();
    }
}