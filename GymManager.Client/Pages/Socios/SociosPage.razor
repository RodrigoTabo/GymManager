@page "/socios"
@using MudBlazor
@using GymManager.Client.ApiClients
@using GymManager.Shared.Contracts.Socios

@inject IDialogService DialogService
@inject SocioApi SocioApi

<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto pa-0">

    <!-- Header -->
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h5">Gestionar Socios</MudText>
                <MudText Typo="Typo.body2" Color="Color.Primary">Alta, edición y pagos de socios</MudText>
            </MudStack>

            <MudButton OnClick="OpenCrear"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AddBox">
                Agregar socio
            </MudButton>
        </MudStack>
    </MudPaper>

    <!-- KPI Cards -->
    <MudGrid Spacing="2" Class="mb-4">

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Outlined="true">
                <MudStack AlignItems="AlignItems.Center" Spacing="1">
                    <MudAvatar Variant="Variant.Filled" Color="Color.Success" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.People" />
                    </MudAvatar>
                    <MudText Typo="Typo.subtitle2" Align="Align.Center">Activos</MudText>
                    <MudText Typo="Typo.h4" Align="Align.Center">@(loadingStats ? "—" : stats.ActivosCount.ToString())</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Outlined="true">
                <MudStack AlignIte ms="AlignItems.Center" Spacing="1">
                    <MudAvatar Variant="Variant.Filled" Color="Color.Error" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.PersonOff" />
                    </MudAvatar>
                    <MudText Typo="Typo.subtitle2" Align="Align.Center">Inactivos</MudText>
                    <MudText Typo="Typo.h4" Align="Align.Center">@(loadingStats ? "—" : stats.InactivosCount.ToString())</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Outlined="true">
                <MudStack AlignItems="AlignItems.Center" Spacing="1">
                    <MudAvatar Variant="Variant.Filled" Color="Color.Info" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" />
                    </MudAvatar>
                    <MudText Typo="Typo.subtitle2" Align="Align.Center">Altas del mes</MudText>
                    <MudText Typo="Typo.h4" Align="Align.Center">@(loadingStats ? "—" : stats.AltasMesCount.ToString())</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Outlined="true">
                <MudStack AlignItems="AlignItems.Center" Spacing="1">
                    <MudAvatar Variant="Variant.Filled" Color="Color.Warning" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.Payments" />
                    </MudAvatar>
                    <MudText Typo="Typo.subtitle2" Align="Align.Center">Cobro del mes</MudText>
                    <MudText Typo="Typo.h4" Align="Align.Center">@(loadingStats ? "—" : stats.CobroMestotal.ToString("N2"))</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>

    </MudGrid>

    <!-- Paneles -->
    <MudGrid Spacing="2" Class="mb-4">

        <!-- Chart -->
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-2">Actividad (últimos 12 meses)</MudText>

                @if (loadingStats)
                {
                    <MudText>Cargando…</MudText>
                }
                else if (_chartLabels.Length == 0)
                {
                    <MudText>Sin datos para el gráfico.</MudText>
                }
                else
                {
                    <MudChart T="double"
                              ChartType="ChartType.Bar"
                              ChartSeries="@_chartSeries"
                              XAxisLabels="@_chartLabels"
                              Width="100%"
                              Height="300px" />
                }
            </MudPaper>
        </MudItem>

        <!-- Últimos pagos -->
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-2">Últimos pagos</MudText>

                @if (loadingStats)
                {
                    <MudText>Cargando…</MudText>
                }
                else if (stats.UltimosPagos is null || stats.UltimosPagos.Count == 0)
                {
                    <MudText>No hay pagos recientes.</MudText>
                }
                else
                {
                    <MudStack Spacing="1">
                        @foreach (var p in stats.UltimosPagos)
                        {
                            <MudPaper Class="pa-2" Elevation="0">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.body2">Socio #{p.SocioId}</MudText>
                                    <MudText Typo="Typo.caption">@p.FechaPago.ToString("dd/MM")</MudText>
                                </MudStack>

                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.caption">Método: @p.MetodoPagoId</MudText>
                                    <MudText Typo="Typo.body2">@p.Importe.ToString("N2")</MudText>
                                </MudStack>
                            </MudPaper>
                        }
                    </MudStack>
                }
            </MudPaper>
        </MudItem>

    </MudGrid>

    <!-- Barra de filtros (afuera de la tabla, sin superposiciones) -->
    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudGrid Spacing="2" AlignItems="AlignItems.Center">

            <MudItem xs="12" md="3">
                <MudSelect T="string"
                           Dense="true"
                           Variant="Variant.Outlined"
                           Label="Filtrar por"
                           Value="@filtro.BuscarPor"
                           ValueChanged="@(EventCallback.Factory.Create<string>(this, v => OnBuscarPorChanged(v)))">
                    <MudSelectItem T="string" Value="@("NombreCompleto")">Nombre Completo</MudSelectItem>
                    <MudSelectItem T="string" Value="@("DNI")">DNI</MudSelectItem>
                    <MudSelectItem T="string" Value="@("PorPlan")">Por plan</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField Dense="true"
                              Variant="Variant.Outlined"
                              Value="@filtro.Texto"
                              ValueChanged="@(EventCallback.Factory.Create<string>(this, v => OnTextoChanged(v)))"
                              Label="Buscar"
                              Placeholder="Escribí para buscar…"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Clearable="true" />
            </MudItem>

            <MudItem xs="12" md="3">
                <MudCheckBox T="bool"
                             Dense="true"
                             Label="Solo inactivos"
                             Color="Color.Secondary"
                             Value="@filtro.Inactivo"
                             ValueChanged="@(EventCallback.Factory.Create<bool>(this, v => OnInactivoChanged(v)))" />
            </MudItem>

        </MudGrid>
    </MudPaper>

    <!-- Tabla (sin toolbar interno) -->
    <MudPaper Class="pa-0" Elevation="1">
        <SocioTable Items="@socios"
                    Loading="@loading"
                    OnEdit="OpenEdit"
                    OnDelete="ConfirmDelete"
                    OnPago="OpenPago" />
    </MudPaper>

</MudContainer>

@code {

    private List<SocioResponse> socios = new();
    private SociosStatsResponse stats = new();

    private string[] _chartLabels = Array.Empty<string>();
    private List<ChartSeries<double>> _chartSeries = new();

    private bool loadingStats;
    private bool loading;

    public SocioQuery filtro { get; set; } = new SocioQuery
    {
        BuscarPor = "NombreCompleto",
        Texto = "",
        Inactivo = false
    };

    protected override async Task OnInitializedAsync()
        => await ReloadAsync();

    private async Task ReloadAsync()
    {
        await LoadStatsAsync();
        await LoadSociosAsync(filtro);
    }

    private async Task LoadSociosAsync(SocioQuery f)
    {
        loading = true;
        try
        {
            socios = await SocioApi.ListarAsync(f);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadStatsAsync()
    {
        loadingStats = true;
        try
        {
            stats = await SocioApi.GetStatsAsync();
            BuildChart();
        }
        finally
        {
            loadingStats = false;
        }
    }

    private void BuildChart()
    {
        if (stats?.Meses == null || stats.Meses.Count == 0)
        {
            _chartLabels = Array.Empty<string>();
            _chartSeries = new List<ChartSeries<double>>();
            return;
        }

        _chartLabels = stats.Meses.ToArray();

        var altas = (stats.AltasPorMes ?? new List<int>()).Select(x => (double)x).ToArray();
        var bajas = (stats.BajasPorMes ?? new List<int>()).Select(x => (double)x).ToArray();

        _chartSeries = new List<ChartSeries<double>>
        {
            new ChartSeries<double> { Name = "Altas", Data = altas },
            new ChartSeries<double> { Name = "Bajas", Data = bajas }
        };
    }

    private async Task OpenCrear()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<SocioDialog>("Crear Socio", options);
        var result = await dialog.Result;

        if (!result.Canceled)
            await ReloadAsync();
    }

    private async Task OpenEdit(SocioResponse socio)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var parameters = new DialogParameters { ["Socio"] = socio };

        var dialog = await DialogService.ShowAsync<SocioDialog>("Editar Socio", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
            await ReloadAsync();
    }

    private async Task OpenPago(SocioResponse socio)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var parameters = new DialogParameters
        {
            ["Socio"] = socio,
            ["SocioNombre"] = $"{socio.Nombre} {socio.Apellido}"
        };

        var dialog = await DialogService.ShowAsync<PagoDialog>("Agregar Pago", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
            await ReloadAsync();
    }

    private async Task ConfirmDelete(SocioResponse socio)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var parameters = new DialogParameters
        {
            ["Socio"] = socio,
            ["ContentText"] = $"¿Seguro que querés eliminar el Socio \"{socio.Nombre} {socio.Apellido}\"?",
            ["ButtonText"] = "Eliminar",
            ["Color"] = Color.Error
        };

        var dialog = await DialogService.ShowAsync<SocioDialogDelete>("Eliminar Socio", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
            await ReloadAsync();
    }

    private async Task HandleFiltroChanged(SocioQuery nuevo)
    {
        filtro = new SocioQuery
        {
            BuscarPor = nuevo.BuscarPor,
            Texto = nuevo.Texto,
            Inactivo = nuevo.Inactivo
        };

        // Performance: solo tabla
        await LoadSociosAsync(filtro);
    }

    private async Task OnBuscarPorChanged(string value)
    {
        filtro.BuscarPor = value;
        await LoadSociosAsync(filtro);
    }

    private async Task OnTextoChanged(string value)
    {
        filtro.Texto = (value ?? "").Trim();
        await LoadSociosAsync(filtro);
    }

    private async Task OnInactivoChanged(bool value)
    {
        filtro.Inactivo = value;
        await LoadSociosAsync(filtro);
    }
}