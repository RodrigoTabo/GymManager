@using GymManager.Client.ApiClients
@using GymManager.Shared.Contracts.Socios
@inject PlanApi PlanApi
@inject SocioApi SocioApi
<MudDialog>
    <TitleContent>
        @(Socio is null ? "Crear Socio" : "Editar Socio")
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <MudAlert Severity="Severity.Error">@Error</MudAlert>
        }
        <MudTextField Label="DNI" Placeholder="Ingresa tu DNI" @bind-Value="@Model.DNI" Disabled="Guardando" />
        <MudTextField Label="Nombre" Placeholder="Ingresa tu Nombre" @bind-value="@Model.Nombre" Disabled="Guardando" />
        <MudTextField Label="Apellido" Placeholder="Ingresa tu Apellido" @bind-value="@Model.Apellido" Disabled="Guardando" />
        <MudDatePicker Label="Fecha de Nacimiento" Placeholder="Ingresa tu Fecha de nacimiento" @bind-value="@Model.FechaDeNacimiento" Disabled="Guardando" />
        <MudSelect T="int" Label="Plan del socio" @bind-Value="Model.PlanId">
            @foreach (var p in Planes)
            {
                <MudSelectItem T="int" Value="p.Id">
                    @p.Nombre
                </MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Create">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    //Declaraciones
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public SocioResponse? Socio { get; set; }
    private string? Error;
    private bool Guardando;
    private bool CargandoPlanes = true;
    private string? ErrorPlanes;
    private SocioFormVM Model = new();
    private void Submit() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel() => MudDialog.Cancel();
    private List<PlanFormVM> Planes = new();

    //Metodo Inicializar automaticamente la lista
    protected override async Task OnInitializedAsync()
    => await LoadPlanesAsync();

    protected override void OnParametersSet()
    {
        if (Socio is null)
        {
            Model = new SocioFormVM();
            return;
        }

        Model.DNI = Socio.DNI;
        Model.Nombre = Socio.Nombre;
        Model.Apellido = Socio.Apellido;
        Model.FechaDeNacimiento = Socio.FechaNacimiento;
        Model.PlanId = Socio.PlanId;
    }


    //Metodo Cargar lista planes.
    public async Task LoadPlanesAsync()
    {
        CargandoPlanes = true;
        ErrorPlanes = null;

        try
        {
            var lista = await PlanApi.ListarAsync();

            Planes = lista
                .Select(p => new PlanFormVM(p.Id, p.Nombre))
                .OrderBy(p => p.Nombre).ToList();

        }
        catch (Exception ex)
        {
            ErrorPlanes = ex.Message;
            Planes = new();
        }
        finally
        {
            CargandoPlanes = false;
        }
    }


    //Metodo Crear Socio
    public async Task Create()
    {
        Guardando = true;
        Error = null;

        if (string.IsNullOrWhiteSpace(Model.DNI))
            Error = "Debes cargar un DNI";
        if (string.IsNullOrWhiteSpace(Model.Nombre))
            Error = "Debes cargar un Nombre";
        if (string.IsNullOrWhiteSpace(Model.Apellido))
            Error = "Debes cargar un Apellido";
        if (Model.PlanId <= 0)
            Error = "Debes cargar un Plan";

        try
        {
            if (Socio is null)
            {
                var request = new CreateSocioRequest(Model.DNI,
                    Model.Nombre,
                    Model.Apellido,
                    Model.FechaDeNacimiento,
                    Model.PlanId,
                    Model.DocumentoId);

                await SocioApi.CrearAsync(request);

            }
            else
            {
                var request = new UpdateSocioRequest(Model.DNI,
                     Model.Nombre,
                     Model.Apellido,
                     Model.FechaDeNacimiento,
                     Model.PlanId,
                     Model.DocumentoId);

                await SocioApi.UpdateAsync(Socio.Id, request);
            }


            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Guardando = false;
        }
    }

    //ViewModels
    public class SocioFormVM
    {
        public string DNI { get; set; }
        public string Nombre { get; set; }
        public string Apellido { get; set; }
        public DateTime? FechaDeNacimiento { get; set; }
        public int PlanId { get; set; }
        public int? DocumentoId { get; set; }
    }

    public record PlanFormVM(int Id, string Nombre);

}
