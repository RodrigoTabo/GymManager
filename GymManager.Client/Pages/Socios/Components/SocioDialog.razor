@using GymManager.Client.ApiClients
@using GymManager.Shared.Contracts.Socios
@inject PlanApi PlanApi
@inject SocioApi SocioApi

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@(Socio is null ? Icons.Material.Filled.PersonAdd : Icons.Material.Filled.Edit)" Color="Color.Primary" />
            <MudText Typo="Typo.h6">
                @(Socio is null ? "Crear socio" : "Editar socio")
            </MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="3" Class="mt-1">

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Filled" Elevation="0">
                    @Error
                </MudAlert>
            }

            <MudPaper Class="pa-4" Outlined="true">
                <MudGrid Spacing="2">

                    <MudItem xs="12" sm="6">
                        <MudTextField Label="DNI"
                                      Placeholder="Ingresá el DNI"
                                      @bind-Value="Model.DNI"
                                      Disabled="Guardando"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Badge" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudDatePicker Label="Fecha de nacimiento"
                                       Placeholder="Seleccioná una fecha"
                                       @bind-Date="Model.FechaDeNacimiento"
                                       Disabled="Guardando"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       DateFormat="dd/MM/yyyy" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField Label="Nombre"
                                      Placeholder="Ingresá el nombre"
                                      @bind-Value="Model.Nombre"
                                      Disabled="Guardando"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Person" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField Label="Apellido"
                                      Placeholder="Ingresá el apellido"
                                      @bind-Value="Model.Apellido"
                                      Disabled="Guardando"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.PersonOutline" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField Label="Teléfono"
                                      Placeholder="Ingresá el teléfono"
                                      @bind-Value="Model.Telefono"
                                      Disabled="Guardando"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Phone" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect T="int"
                                   Label="Plan del socio"
                                   @bind-Value="Model.PlanId"
                                   Disabled="Guardando"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            @foreach (var p in Planes)
                            {
                                <MudSelectItem T="int" Value="@p.Id">
                                    @p.Nombre
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                </MudGrid>
            </MudPaper>
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="w-100">
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       OnClick="Cancel"
                       Disabled="Guardando">
                Cancelar
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="Create"
                       Disabled="Guardando"
                       StartIcon="@Icons.Material.Filled.Save">
                @(Guardando ? "Guardando..." : "Guardar")
            </MudButton>
        </MudStack>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public SocioResponse? Socio { get; set; }

    private string? Error;
    private bool Guardando;
    private bool CargandoPlanes = true;
    private string? ErrorPlanes;
    private SocioFormVM Model = new();
    private void Submit() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel() => MudDialog.Cancel();
    private List<PlanFormVM> Planes = new();

    protected override async Task OnInitializedAsync()
    => await LoadPlanesAsync();

    protected override void OnParametersSet()
    {
        if (Socio is null)
        {
            Model = new SocioFormVM();
            return;
        }

        Model.DNI = Socio.DNI;
        Model.Nombre = Socio.Nombre;
        Model.Apellido = Socio.Apellido;
        Model.Telefono = Socio.Telefono;
        Model.FechaDeNacimiento = Socio.FechaNacimiento;
        Model.PlanId = Socio.PlanId;
    }

    public async Task LoadPlanesAsync()
    {
        CargandoPlanes = true;
        ErrorPlanes = null;

        try
        {
            var lista = await PlanApi.ListarAsync();

            Planes = lista
                .Select(p => new PlanFormVM(p.Id, p.Nombre))
                .OrderBy(p => p.Nombre).ToList();

        }
        catch (Exception ex)
        {
            ErrorPlanes = ex.Message;
            Planes = new();
        }
        finally
        {
            CargandoPlanes = false;
        }
    }

    public async Task Create()
    {
        Guardando = true;
        Error = null;

        if (string.IsNullOrWhiteSpace(Model.DNI))
            Error = "Debes cargar un DNI";
        if (string.IsNullOrWhiteSpace(Model.Nombre))
            Error = "Debes cargar un Nombre";
        if (string.IsNullOrWhiteSpace(Model.Apellido))
            Error = "Debes cargar un Apellido";
        if (Model.PlanId <= 0)
            Error = "Debes cargar un Plan";

        try
        {
            if (Socio is null)
            {
                var request = new CreateSocioRequest(Model.DNI,
                    Model.Nombre,
                    Model.Apellido,
                    Model.Telefono,
                    Model.FechaDeNacimiento,
                    Model.PlanId,
                    Model.DocumentoId);

                await SocioApi.CrearAsync(request);

            }
            else
            {
                var request = new UpdateSocioRequest(Model.DNI,
                     Model.Nombre,
                     Model.Apellido,
                     Model.Telefono,
                     Model.FechaDeNacimiento,
                     Model.PlanId,
                     Model.DocumentoId);

                await SocioApi.UpdateAsync(Socio.Id, request);
            }


            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Guardando = false;
        }
    }


    public class SocioFormVM
    {
        public string DNI { get; set; }
        public string Nombre { get; set; }
        public string Apellido { get; set; }
        public uint Telefono { get; set; }
        public DateTime? FechaDeNacimiento { get; set; }
        public int PlanId { get; set; }
        public int? DocumentoId { get; set; }
    }

    public record PlanFormVM(int Id, string Nombre);

}
