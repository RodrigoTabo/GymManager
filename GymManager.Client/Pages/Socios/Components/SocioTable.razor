@using MudBlazor
@using GymManager.Shared.Contracts.Socios

<MudTable T="SocioResponse"
          Items="@Items"
          Hover="true"
          Dense="true"
          Breakpoint="Breakpoint.None"
          Loading="@Loading"
          LoadingProgressColor="Color.Info"
          HorizontalScrollbar="true"
          Elevation="0">

    <HeaderContent>
        <MudTh>DNI</MudTh>
        <MudTh>Nombre completo</MudTh>
        <MudTh>Telefono</MudTh>
        <MudTh>Fecha Nac.</MudTh>
        <MudTh>Alta</MudTh>
        <MudTh>Plan</MudTh>
        <MudTh>Acciones</MudTh>
    </HeaderContent>

    <RowTemplate>

        <MudTd DataLabel="DNI ingresado">
            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small">
                @context.DNI
            </MudChip>
        </MudTd>

        <MudTd DataLabel="Socio">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudAvatar Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                </MudAvatar>
                <MudTd DataLabel="Nombre">@context.Nombre @context.Apellido</MudTd>
            </MudStack>
        </MudTd>

        <MudTd DataLabel="Telefono">
            <MudChip T="uint" Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small">
                @context.Telefono
            </MudChip>
        </MudTd>

        <MudTd DataLabel="Fecha Nac.">
            @(context.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "-")
        </MudTd>

        <MudTd DataLabel="Alta">
            <MudChip T="string"
                     Size="Size.Small"
                     Variant="Variant.Filled"
                     Color="Color.Success">
                @(context.FechaAlta?.ToString("dd/MM/yyyy") ?? "-")
            </MudChip>
        </MudTd>

        <MudTd DataLabel="Plan">
            <MudChip T="string"
                     Size="Size.Small"
                     Variant="Variant.Filled"
                     Color="Color.Info">
                @(string.IsNullOrWhiteSpace(context.Plan) ? "-" : context.Plan)
            </MudChip>
        </MudTd>

        <MudTd DataLabel="Acciones">
            <MudStack Row="true" Spacing="1">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                               OnClick="@(() => OnEdit.InvokeAsync(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Payments" Color="Color.Success" Size="Size.Small"
                               OnClick="@(() => OnPago.InvokeAsync(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                               OnClick="@(() => OnDelete.InvokeAsync(context))" />
            </MudStack>
        </MudTd>
    </RowTemplate>

    <NoRecordsContent>
        <MudStack Class="pa-6" AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" />
            <MudText Typo="Typo.body1">No hay socios para mostrar</MudText>
            <MudText Typo="Typo.caption">Probá cambiando los filtros.</MudText>
        </MudStack>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
    </PagerContent>
</MudTable>

@code {
    [Parameter] public List<SocioResponse> Items { get; set; } = new();
    [Parameter] public bool Loading { get; set; }

    [Parameter] public EventCallback<SocioResponse> OnEdit { get; set; }
    [Parameter] public EventCallback<SocioResponse> OnDelete { get; set; }
    [Parameter] public EventCallback<SocioResponse> OnPago { get; set; }


}