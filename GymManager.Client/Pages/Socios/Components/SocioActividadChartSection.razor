@*Este componente queda inhabilitado hasta que le de un buen uso.*@

@using GymManager.Shared.Contracts.Socios

<MudItem xs="12" md="8">
    <MudPaper Class="pa-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-3">Actividad (últimos 12 meses)</MudText>

        @if (Loading)
        {
            <MudText>Cargando…</MudText>
        }
        else if (_chartLabels.Length == 0)
        {
            <MudText>Sin datos para el gráfico.</MudText>
        }
        else
        {
            <MudStack AlignItems="AlignItems.Center">
                <div style="width: 100%; max-width: 950px;">
                    <MudChart T="double"
                              ChartType="ChartType.StackedBar"
                              ChartSeries="@_chartSeries"
                              ChartLabels="@_chartLabels"
                              ChartOptions="@_stackedOptions"
                              Height="420px" />
                </div>
            </MudStack>
        }
    </MudPaper>
</MudItem>

@code {
    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public SociosStatsResponse Stats { get; set; } = new();

    private string[] _chartLabels = Array.Empty<string>();
    private List<ChartSeries<double>> _chartSeries = new();

    private StackedBarChartOptions _stackedOptions = new()
    {
        BarWidthRatio = 0.7
    };

    protected override void OnParametersSet()
    {
        BuildChart();
    }

    private void BuildChart()
    {
        if (Stats?.Meses == null || Stats.Meses.Count == 0)
        {
            _chartLabels = Array.Empty<string>();
            _chartSeries = new();
            return;
        }

        var labels = Stats.Meses.ToArray();
        var altas = (Stats.AltasPorMes ?? new List<int>()).Select(x => (double)x).ToArray();
        var bajas = (Stats.BajasPorMes ?? new List<int>()).Select(x => (double)x).ToArray();

        var cantidad = new[] { labels.Length, altas.Length, bajas.Length }.Min();

        _chartLabels = labels.Take(cantidad).ToArray();

        _chartSeries = new()
        {
            new ChartSeries<double>
            {
                Name = "Altas",
                Data = altas.Take(cantidad).ToArray()
            },
            new ChartSeries<double>
            {
                Name = "Bajas",
                Data = bajas.Take(cantidad).ToArray()
            }
        };
    }
}