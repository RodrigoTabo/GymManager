@using GymManager.Shared.Contracts.General
@using GymManager.Shared.Contracts.Pagos
    

<MudPaper Class="pa-0 h-100" Elevation="2" Style="border-radius:5px; overflow:hidden;">

    <MudStack Class="pa-3"
              Style=@ColorBar>
            
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudAvatar Variant="Variant.Filled" Style="@ColorBar" Size="Size.Small">
                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small" />
            </MudAvatar>

            <MudStack Spacing="0">
                <MudText Typo="Typo.subtitle2" Style="color:white;">
                    @Titulo
                </MudText>
                <MudText Typo="Typo.caption" Style="color:white;">
                    @SubTitulo
                </MudText>
            </MudStack>
        </MudStack>
    </MudStack>

    <MudStack Class="pa-3" Spacing="2">

        @if (Loading)
        {
            <MudStack Spacing="1">
                <MudSkeleton Height="18px" Width="70%" />
                <MudSkeleton Height="18px" Width="60%" />
                <MudSkeleton Height="18px" Width="50%" />
            </MudStack>
        }
        else if (Items is not null && Items.Any())
        {
            @foreach (var item in Items.Take(CantidadMostrar).Select((value, index) => new { value, index }))
            {
                var vencido = item.value;
                var posicion = item.index + 1;

                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween"
                          Class="py-1">

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudAvatar Variant="Variant.Filled"
                                   Style="@ColorBar"
                                   Color="Color.Primary"
                                   Size="Size.Small">
                            @posicion
                        </MudAvatar>

                        <MudText Typo="Typo.body2">
                            @($"{vencido.NombreCompleto} ({vencido.Plan}) - {vencido.VenceEn:dd/MM}")
                        </MudText>

                    </MudStack>

                    <MudText Typo="Typo.body2"
                             Style="font-weight:600; color:#e53935;">
                        @vencido.Importe.ToString("C")
                    </MudText>

                </MudStack>

                @if (posicion < CantidadMostrar)
                {
                    <MudDivider />
                }
            }
        }
        else
        {
            <MudStack AlignItems="AlignItems.Center" Class="py-4" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.EventAvailable"
                         Size="Size.Medium"
                         Color="Color.Success" />

                <MudText Typo="Typo.subtitle2">
                    No hay datos
                </MudText>

                <MudText Typo="Typo.caption" Style="opacity:0.7;">
                    @TextoVacio
                </MudText>
            </MudStack>
        }

    </MudStack>
</MudPaper>

@code {
    [Parameter]
    public string Titulo { get; set; } = "Top 3 del mes";

    [Parameter]
    public string SubTitulo { get; set; } = "Vencimientos";

    [Parameter]
    public Color Color { get; set; }

    [Parameter]
    public List<VencidoResponse> Items { get; set; } = new();

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public int CantidadMostrar { get; set; } = 3;

    [Parameter]
    public string TextoVacio { get; set; } = "No hay vencimientos próximos.";

    [Parameter]
    public string ColorBar { get; set; } = "background:#e53935;";

}