@using GymManager.Client.ApiClients
@using GymManager.Client.Pages.Panel_Administrativo.MetodosPagoComponents
@using GymManager.Shared.Contracts.MetodoPago
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject MetodoPagoApi MetodoPagoApi

<!--Table-->
<MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius:18px;">

    <MudStack Row="true"
              AlignItems="AlignItems.Center"
              Justify="Justify.SpaceBetween"
              Class="mb-4">


        <MudStack Spacing="0">
            <MudText Style="font-weight: bold;" Typo="Typo.h6">
                Métodos de pagos
            </MudText>
            <MudText Typo="Typo.subtitle2">
                Habilita o deshabilita las formas de pago aceptadas
            </MudText>
        </MudStack>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Disabled="@(loading)"
                   OnClick="ReloadAsync">
            Nuevo método
        </MudButton>
    </MudStack>
</MudPaper>

<MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius:18px;">
    <MetodosPagoCard Items="@metodoPagoResponse"
                     Loading="@loading" />
</MudPaper>

@code {
    [Parameter]
    public Guid SucursalId { get; set; }

    private List<MetodoPagoResponse> metodoPagoResponse = new();
    private bool loading;


    protected override async Task OnInitializedAsync()
    => await ReloadAsync();

    private async Task ReloadAsync()
    {
        await LoadMetodosPagoAsync();
    }

    private async Task LoadMetodosPagoAsync()
    {
        loading = true;

        try
        {
            metodoPagoResponse = await MetodoPagoApi.ListarAsync(SucursalId);
        }
        finally
        {
            loading = false;
        }
    }

}
