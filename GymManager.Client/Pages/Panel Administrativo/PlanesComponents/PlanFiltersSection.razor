<MudStack Row="true"
          AlignItems="AlignItems.Center"
          Justify="Justify.SpaceBetween"
          Class="mb-4">

    <MudStack Spacing="0">
        <MudText Typo="Typo.h4" Style="font-weight: 700;" >Planes de suscripción</MudText>
        <MudText Typo="Typo.body2" Class="text-muted">
            Gestioná las tarifas y beneficios de tus planes actuales.
        </MudText>  
    </MudStack>

    <MudButton OnClick="OpenCrear"
               Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.AddBox">
        Agregar plan
    </MudButton>
</MudStack>

@code {

    [Parameter]
    public EventCallback OpenCrear { get; set; }

}
