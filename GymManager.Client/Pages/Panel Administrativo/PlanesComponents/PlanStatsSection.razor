@using GymManager.Client.Components
@using GymManager.Shared.Contracts.Planes

<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" sm="6" md="3">
        <KpiCard Titulo="Planes Activos"
                 Valor="@(Stats.PlanActivos.ToString("N0"))"
                 Loading="@Loading"
                 Icon="@Icons.Material.Filled.CalendarMonth"
                 Color="Color.Primary" />
    </MudItem>

    <MudItem xs="12">
        <PlanTopSection Loading="Loading"
                        Stats="Stats" />
    </MudItem>
</MudGrid>

@code {

    [Parameter]
    public StatsPlanRequest Stats { get; set; } = new();

    [Parameter]
    public bool Loading { get; set; }

}
