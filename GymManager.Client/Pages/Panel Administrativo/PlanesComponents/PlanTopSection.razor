@using GymManager.Shared.Contracts.Planes

<MudPaper Class="pa-0 h-100" Elevation="2" Style="border-radius:5px; overflow:hidden;">

    <MudStack Class="pa-3" Style="background:#00c853;">

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudAvatar Variant="Variant.Filled" Style="background:#00c853;" Size="Size.Small">
                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Size="Size.Small" Style="color:#ffc107;" />
            </MudAvatar>

            <MudStack Spacing="0">
                <MudText Typo="Typo.subtitle2" Style="color:white;">
                    Top 3 Planes
                </MudText>
                <MudText Typo="Typo.caption" Style="color:white;">
                    Más vendidos
                </MudText>
            </MudStack>
        </MudStack>

    </MudStack>

    <MudStack Class="pa-3" Spacing="2">

        @if (Loading)
        {
            <MudStack Spacing="1">
                <MudSkeleton Height="18px" Width="70%" />
                <MudSkeleton Height="18px" Width="60%" />
                <MudSkeleton Height="18px" Width="50%" />
            </MudStack>
        }
        else if (Stats.TopPlanes is not null && Stats.TopPlanes.Any())
        {
            @for (int i = 0; i < Stats.TopPlanes.Count; i++)
            {
                var plan = Stats.TopPlanes[i];
                var posicion = i + 1;

                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween"
                          Class="py-1">

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">

                        <MudAvatar Variant="Variant.Filled"
                                   Style="background:#00c853;"
                                   Size="Size.Small">
                            @posicion
                        </MudAvatar>

                        <MudText Typo="Typo.body2" Style="font-weight:500;">
                            @plan.NombrePlan
                        </MudText>

                    </MudStack>

                    <MudText Typo="Typo.body2"
                             Style="font-weight:600; color:#00c853;">
                        @plan.Cantidad
                    </MudText>

                </MudStack>

                @if (posicion < Stats.TopPlanes.Count)
                {
                    <MudDivider />
                }
            }
        }
        else
        {
            <MudStack AlignItems="AlignItems.Center" Class="py-4" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents"
                         Size="Size.Medium"
                         Style="color:#00c853;" />

                <MudText Typo="Typo.subtitle2">
                    No hay datos
                </MudText>

                <MudText Typo="Typo.caption" Style="opacity:0.7;">
                    No hay planes registrados.
                </MudText>
            </MudStack>
        }

    </MudStack>
</MudPaper>
@code {

    [Parameter]
    public StatsPlanRequest Stats { get; set; } = new();

    [Parameter]
    public bool Loading { get; set; }

}
