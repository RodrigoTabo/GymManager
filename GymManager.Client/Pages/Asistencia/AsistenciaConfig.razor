@page "/asistencia/config"
@using GymManager.Shared.Contracts.Asistencias
@using GymManager.Client.ApiClients
@inject AsistenciaApi AsistenciaApi


<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto pa-0">

    <!-- Header -->
    <MudPaper Class="pa-4 mb-4" Elevation="5">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h5">Gestionar Asistencias</MudText>
            </MudStack>
        </MudStack>
    </MudPaper>

    <!-- Filtros -->
    <MudPaper Class="pa-4 mb-4" Elevation="5">

        <MudGrid Spacing="2" AlignItems="AlignItems.Center">

            <MudItem xs="12" sm="6" md="3">
                <MudTextField T="string"
                              Dense="true"
                              Margin="Margin.Dense"
                              Variant="Variant.Outlined"
                              Value="@filtro.Dni"
                              ValueChanged="@(EventCallback.Factory.Create<string>(this, v => OnDniChanged(v)))"
                              Label="DNI"
                              Placeholder="Buscar por DNI..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Badge"
                              Clearable="true" />
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudTextField T="string"
                              Dense="true"
                              Margin="Margin.Dense"
                              Variant="Variant.Outlined"
                              Value="@filtro.Nombre"
                              ValueChanged="@(EventCallback.Factory.Create<string>(this, v => OnNombreChanged(v)))"
                              Label="Nombre"
                              Placeholder="Buscar por nombre..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Clearable="true" />
            </MudItem>

            <MudItem xs="12" sm="6" md="2">
                <MudDatePicker Label="Desde"
                               Dense="true"
                               Margin="Margin.Dense"
                               Variant="Variant.Outlined"
                               Date="@filtro.Desde"
                               DateChanged="@(EventCallback.Factory.Create<DateTime?>(this, v => OnDesdeChanged(v)))"
                               Clearable="true" />
            </MudItem>

            <MudItem xs="12" sm="6" md="2">
                <MudDatePicker Label="Hasta"
                               Dense="true"
                               Margin="Margin.Dense"
                               Variant="Variant.Outlined"
                               Date="@filtro.Hasta"
                               DateChanged="@(EventCallback.Factory.Create<DateTime?>(this, v => OnHastaChanged(v)))"
                               Clearable="true" />
            </MudItem>

            <MudItem xs="12" md="2" Class="d-flex align-center">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Style="height:36px; min-width:110px;"
                           StartIcon="@Icons.Material.Filled.Clear"
                           OnClick="LimpiarFiltros">
                    Limpiar
                </MudButton>
            </MudItem>

        </MudGrid>
    </MudPaper>

    <!-- Tabla -->
    <MudPaper Class="pa-4" Elevation="5">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mb-3">
            <MudStack Spacing="0">
                <MudText Typo="Typo.subtitle1">Asistencias registradas</MudText>
                <MudText Typo="Typo.body2">
                    Historial de ingresos validados del gimnasio.
                </MudText>
            </MudStack>
        </MudStack>

        <MudDivider Class="mb-3" />

        <AsistenciaTable Items="@Asistencias"
                         Loading="@loading" />
    </MudPaper>

</MudContainer>

@code {

    private List<AsistenciaResponse> Asistencias = new();
    private bool loading;
    private AsistenciaFiltro filtro { get; set; } = new()
    {
        Dni = string.Empty,
        Nombre = string.Empty,
        Desde = null,
        Hasta = null
    };

    protected override async Task OnInitializedAsync()
    => await ReloadAsync();

    private async Task ReloadAsync()
    {
        await LoadAsistenciasAsync(filtro);
    }

    private async Task LoadAsistenciasAsync(AsistenciaFiltro f)
    {
        loading = true;
        try
        {
            Asistencias = await AsistenciaApi.ListarAsync(f);
        }
        finally
        {
            loading = false;
        }

    }

    private async Task OnDniChanged(string value)
    {
        filtro.Dni = value;
        await ReloadAsync();
    }

    private async Task OnNombreChanged(string value)
    {
        filtro.Nombre = value;
        await ReloadAsync();
    }

    private async Task OnDesdeChanged(DateTime? value)
    {
        filtro.Desde = value;
        await ReloadAsync();
    }

    private async Task OnHastaChanged(DateTime? value)
    {
        filtro.Hasta = value;
        await ReloadAsync();
    }

    private async Task LimpiarFiltros()
    {
        filtro = new AsistenciaFiltro();
        await ReloadAsync();
    }

}
