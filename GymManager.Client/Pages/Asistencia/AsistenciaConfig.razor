@page "/sucursal/{SucursalId:guid}/asistencia/config"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using GymManager.Shared.Contracts.Asistencias
@using GymManager.Client.ApiClients
@inject AsistenciaApi AsistenciaApi


<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto pa-0">

    <!-- Header -->
    <MudPaper Class="pa-4 mb-4" Elevation="5">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h5">Gestionar Asistencias</MudText>
            </MudStack>
        </MudStack>
    </MudPaper>

    <!-- Filtros -->
    <AsistenciaFiltersSection Filtro="Filtro"
                              LimpiarFiltros="LimpiarFiltros"
                              OnDesdeChanged="OnDesdeChanged"
                              OnHastaChanged="OnHastaChanged"
                              OnDniChanged="OnDniChanged"
                              OnNombreChanged="OnNombreChanged" />

    <!-- Tabla -->
    <MudPaper Class="pa-4" Elevation="5">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mb-3">
            <MudStack Spacing="0">
                <MudText Typo="Typo.subtitle1">Asistencias registradas</MudText>
                <MudText Typo="Typo.body2">
                    Historial de ingresos validados del gimnasio.
                </MudText>
            </MudStack>
        </MudStack>

        <MudDivider Class="mb-3" />

        <AsistenciaTable Items="@Asistencias"
                         Loading="@loading" />
    </MudPaper>

</MudContainer>

@code {

    [Parameter]
    public Guid SucursalId { get; set; }

    private List<AsistenciaResponse> Asistencias = new();
    private bool loading;
    private AsistenciaFiltro Filtro { get; set; } = new()
    {
        Dni = string.Empty,
        Nombre = string.Empty,
        Desde = null,
        Hasta = null
    };

    protected override async Task OnInitializedAsync()
    => await ReloadAsync();

    private async Task ReloadAsync()
    {
        await LoadAsistenciasAsync();
    }

    private async Task LoadAsistenciasAsync()
    {
        loading = true;
        try
        {
            Asistencias = await AsistenciaApi.ListarAsync(SucursalId, Filtro);
        }
        finally
        {
            loading = false;
        }

    }

    private async Task OnDniChanged(string value)
    {
        Filtro.Dni = value;
        await ReloadAsync();
    }

    private async Task OnNombreChanged(string value)
    {
        Filtro.Nombre = value;
        await ReloadAsync();
    }

    private async Task OnDesdeChanged(DateTime? value)
    {
        Filtro.Desde = value;
        await ReloadAsync();
    }

    private async Task OnHastaChanged(DateTime? value)
    {
        Filtro.Hasta = value;
        await ReloadAsync();
    }

    private async Task LimpiarFiltros()
    {
        Filtro = new AsistenciaFiltro();
        await ReloadAsync();
    }

}
