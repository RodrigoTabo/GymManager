<MudContainer MaxWidth="MaxWidth.Large"
              Class="d-flex justify-center align-center"
              Style="min-height: 85vh;">

    <MudPaper Elevation="8" Class="w-100 overflow-hidden" Style="border-radius:10px; max-width:500px;">

        <MudPaper Class="pa-6" Square="true" Elevation="0" Style="background: var(--mud-palette-primary);">
            <MudText Typo="Typo.h5" Class="white-text" Align="Align.Center">
                Asistencia
            </MudText>
        </MudPaper>

        <MudStack Spacing="4" Class="pa-8" AlignItems="AlignItems.Center">

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <MudAlert Severity="Severity.Error">@Error</MudAlert>
            }

            <MudAvatar Size="Size.Large" Variant="Variant.Filled">
                <MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size:48px;" />
            </MudAvatar>

            <MudTextField @bind-Value="dni"
                          Label="Ingresá con tu DNI"
                          Placeholder="Por ejemplo: 123456789 (Sin puntos)"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          FullWidth="true"
                          InputType="InputType.Telephone"
                          MaxLength="9"
                          Style="font-size:1.2rem; padding:0.8rem;"
                          Disabled="Guardando" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.CheckCircle"
                       Style="padding:1rem; font-size:1.1rem;"
                       OnClick="OnMarcar"
                       Disabled="Guardando">
                Marcar Asistencia
            </MudButton>

        </MudStack>

    </MudPaper>

</MudContainer>



@code {

    private string dni;

    [Parameter]
    public string? Error { get; set; }
    [Parameter]
    public bool Guardando { get; set; }

    [Parameter]
    public EventCallback<string> enviarDNI { get; set; }

    private async Task OnMarcar()
    {
        await enviarDNI.InvokeAsync(dni);
    }


}
