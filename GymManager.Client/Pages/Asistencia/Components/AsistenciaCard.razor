<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex justify-center">
    <MudPaper Elevation="8" Class="w-100 overflow-hidden" Style="border-radius:16px;">

        <MudPaper Class="pa-4" Square="true" Elevation="0" Style="background: var(--mud-palette-primary);">
            <MudText Typo="Typo.h6" Class="white-text" Align="Align.Center">
                Asistencia
            </MudText>
        </MudPaper>

        <MudStack Spacing="3" Class="pa-6" AlignItems="AlignItems.Center">

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <MudAlert Severity="Severity.Error">@Error</MudAlert>
            }

            <MudAvatar Size="Size.Large" Variant="Variant.Filled">
                <MudIcon Icon="@Icons.Material.Filled.Person" />
            </MudAvatar>

            <MudTextField @bind-Value="dni"
                          Label="Ingresá con tu DNI"
                          Placeholder="Por ejemplo: 123456789 (Sin puntos)"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          FullWidth="true"
                          InputType="InputType.Telephone"
                          MaxLength="9" 
                          Disabled = "Guardando"/>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.CheckCircle"
                       OnClick="OnMarcar"
                       Disabled="Guardando">
                Marcar Asistencia
            </MudButton>

        </MudStack>
    </MudPaper>
</MudContainer>


@code {

    private string dni;

    [Parameter]
    public string Error { get; set; }
    [Parameter]
    public bool Guardando { get; set; }

    [Parameter]
    public EventCallback<string> enviarDNI { get; set; }

    private async Task OnMarcar()
    {
        await enviarDNI.InvokeAsync(dni);
    }


}
