@attribute [Authorize]
@page "/asistencias"
@layout AuthLayout
@using Microsoft.AspNetCore.Authorization
@using GymManager.Client.ApiClients
@using GymManager.Client.ApiClients.Common
@using GymManager.Shared.Contracts.Asistencias
@using System.Net
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject AsistenciaApi AsistenciaApi;

<MudContainer MaxWidth="MaxWidth.False"
              Class="pa-0 d-flex flex-column align-center justify-center"
              Style="min-height: 75vh; gap:16px;">

    <!-- CARD DE ASISTENCIA -->
    <AsistenciaCard Error="@Error"
                    Guardando="@Guardando"
                    enviarDNI="MarcarAsistencia" />

    <!-- BOTÓN VOLVER DEBAJO -->
    <MudButton Variant="Variant.Text"
               Color="Color.Default"
               Style="opacity:0.7; font-weight:500;"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               OnClick="VolverAGeneral">
        Volver
    </MudButton>

</MudContainer>
@code {

    private string? Error;
    private bool Guardando;

    private void VolverAGeneral()
    {
        Nav.NavigateTo("/general");
    }


    private async Task MarcarAsistencia(string dni)
    {
        if (Guardando) return;

        Error = null;
        Guardando = true;


        var dniNormalizado = new string((dni ?? "")
                .Trim()
                .Where(char.IsDigit)
                .ToArray());

        if (string.IsNullOrWhiteSpace(dniNormalizado))
        {
            Error = "El DNI es obligatorio.";
            Guardando = false;
            return;
        }

        try
        {
            var asistencia = new MarcarAsistenciaRequest(dniNormalizado);
            var resp = await AsistenciaApi.MarcarPorDniAsync(asistencia);

            Snackbar.Add(resp.Mensaje, Severity.Success);

        }
        catch (HttpApiException ex)
        {
            if (ex.StatusCode == HttpStatusCode.Conflict)
            {
                Snackbar.Add(ex.Message, Severity.Warning);
            }
            else
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Ocurrió un error inesperado. Intentá de nuevo.", Severity.Error);
        }
        finally
        {
            Guardando = false;
        }
    }

}
