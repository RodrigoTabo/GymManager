@page "/sucursal/{SucursalId:guid}/asistencia"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using GymManager.Client.ApiClients
@using GymManager.Client.ApiClients.Common
@using GymManager.Shared.Contracts.Asistencias
@using System.Net
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AsistenciaApi AsistenciaApi;

<MudContainer MaxWidth="MaxWidth.False"
              Class="pa-0 d-flex align-center justify-center"
              Style="min-height: 75vh;">

    <AsistenciaCard Error="@Error"
                    Guardando="@Guardando"
                    enviarDNI="MarcarAsistencia" />
</MudContainer>
@code {

    [Parameter]
    public Guid SucursalId { get; set; }

    private string? Error;
    private bool Guardando;

    private async Task MarcarAsistencia(string dni)
    {
        if (Guardando) return;

        Error = null;
        Guardando = true;


        var dniNormalizado = new string((dni ?? "")
                .Trim()
                .Where(char.IsDigit)
                .ToArray());

        if (string.IsNullOrWhiteSpace(dniNormalizado))
        {
            Error = "El DNI es obligatorio.";
            Guardando = false;
            return;
        }

        try
        {
            var asistencia = new MarcarAsistenciaRequest(dniNormalizado);
            var resp = await AsistenciaApi.MarcarPorDniAsync(SucursalId, asistencia);

            Snackbar.Add(resp.Mensaje, Severity.Success);

        }
        catch (HttpApiException ex)
        {
            if (ex.StatusCode == HttpStatusCode.Conflict)
            {
                Snackbar.Add(ex.Message, Severity.Warning);
            }
            else
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Ocurrió un error inesperado. Intentá de nuevo.", Severity.Error);
        }
        finally
        {
            Guardando = false;
        }
    }

}
