@page "/sucursal/{SucursalId:guid}/control-de-pagos"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using GymManager.Client.Pages.Pagos
<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto pa-0">

    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudStack Spacing="1">
            <MudText Typo="Typo.h5">Control de finanzas y vencimientos</MudText>
            <MudText Typo="Typo.body2" Class="mud-primary-text">
                Seguimiento de registros de pagos y socios vencidos con deudas.
            </MudText>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-2" Elevation="2">
        <MudTabs Rounded="true"
                 Elevation="0"
                 PanelClass="pa-2"
                 ActivePanelIndex="@activePanelIndex"
                 ActivePanelIndexChanged="@OnPanelChanged">

            <MudTabPanel Text="Pagos realizados" Icon="@Icons.Material.Filled.Payments">
                <PagosPage SucursalId="SucursalId" />
            </MudTabPanel>

            <MudTabPanel Text="Vencimientos" Icon="@Icons.Material.Filled.PersonAddDisabled">
                <VencidosPage SucursalId="SucursalId" />
            </MudTabPanel>

        </MudTabs>
    </MudPaper>

</MudContainer>


@code {
    private int activePanelIndex = 0;

    [Parameter]
    public Guid SucursalId { get; set; }

    private void OnPanelChanged(int index)
    {
        activePanelIndex = index;
    }
}