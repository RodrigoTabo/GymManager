@using GymManager.Shared.Contracts.IntentosAcceso

<MudTable Items="@Items"
          Hover="true"
          Dense="true"
          Breakpoint="Breakpoint.None"
          Loading="@Loading"
          Bordered="true"
          LoadingProgressColor="Color.Info"
          HorizontalScrollbar="true"
          Elevation="0">

    <HeaderContent>
        <MudTh>Fecha registro</MudTh>
        <MudTh>DNI ingresado</MudTh>
        <MudTh>Socio</MudTh>
        <MudTh>Resultado</MudTh>
        <MudTh>Motivo</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="Fecha registro">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudAvatar Size="Size.Small" Variant="Variant.Filled" Color="Color.Dark">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" />
                </MudAvatar>
                <MudText Typo="Typo.body2">@context.FechaRegistro.ToString("dd/MM/yyyy") @context.FechaRegistro.ToString("HH:mm")</MudText>
            </MudStack>
        </MudTd>

        <MudTd DataLabel="DNI ingresado">
            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small">
                @context.DniIngresado
            </MudChip>
        </MudTd>

        <MudTd DataLabel="Socio">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudAvatar Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                </MudAvatar>
                <MudText Typo="Typo.body2">@context.Socio</MudText>
            </MudStack>
        </MudTd>

        <MudTd DataLabel="Resultado">
            <MudChip T="string"
                     Size="Size.Small"
                     Variant="Variant.Filled"
                     Color="@(context.Resultado?.ToString() == "Aceptada" ? Color.Success : Color.Error)">
                @context.Resultado
            </MudChip>
        </MudTd>

        <MudTd DataLabel="Motivo">
            <MudChip T="string"
                     Size="Size.Small"
                     Variant="Variant.Filled"
                     Color="Color.Warning">
                @context.Motivo
            </MudChip>
        </MudTd>
    </RowTemplate>

    <NoRecordsContent>
        <MudStack Class="pa-6" AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.body1">No hay intentos de acceso para mostrar</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Probá cambiando los filtros.</MudText>
        </MudStack>
    </NoRecordsContent>

    <PagerContent>
        <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }"
                       RowsPerPageString="Filas por página"
                       InfoFormat="{first_item}-{last_item} de {all_items}" />
    </PagerContent>
</MudTable>
@code {

    [Parameter]
    public List<IntentosAccesoResponse> Items { get; set; } = new();
    [Parameter]
    public bool Loading { get; set; }

}
