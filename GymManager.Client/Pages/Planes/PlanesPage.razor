@page "/planes"
@using GymManager.Client.ApiClients
@using GymManager.Shared.Contracts.Planes
@inject IDialogService DialogService
@inject PlanApi PlanApi

<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto pa-0">

    <!-- KPIs + Top -->
    <PlanStatsSection Loading="LoadingStats"
                      Stats="Stats" />

    <!-- Tabla y Filtro -->
    <MudPaper Class="pa-4 mb-3" Elevation="5">
        <PlanFiltersSection OpenCrear="OpenCrear" />

        <PlanTable Items="@planes"
                   Loading="@loading"
                   OnEdit="OpenEdit"
                   OnDelete="ConfirmDelete" />
    </MudPaper>

</MudContainer>
@code {
    private List<PlanResponse> planes = new();
    private bool loading;
    private string? errorStats;

    private bool LoadingStats;
    private StatsPlanRequest Stats = new()
    {
        TopPlanes = new List<PlanContadorResponse>()
    };

    //Inicializa la lista llamando al metodo.
    protected override async Task OnInitializedAsync()
      => await LoadPlanesAsync();

    private async Task LoadPlanesAsync()
    {
        loading = true;
        planes = await PlanApi.ListarAsync();
        loading = false;
        await LoadStatsAsync();
    }

    private async Task LoadStatsAsync()
    {
        LoadingStats = true;
        errorStats = null;

        try
        {
            Stats = await PlanApi.GetPlanStatsAsync();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorStats = ex.Message;
            Stats = new() { TopPlanes = new List<PlanContadorResponse>() };
        }
        finally
        {
            LoadingStats = false;
        }
    }

    //Llama al modal Crear
    private async Task OpenCrear()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };

        var dialog = await DialogService.ShowAsync<PlanDialog>("Crear Plan", options);

        var result = await dialog.Result;

        if (!result.Canceled)
            await LoadPlanesAsync();
    }

    //Llama al modal Editar
    private async Task OpenEdit(PlanResponse plan)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };

        var parameters = new DialogParameters
        {
            ["Plan"] = plan
        };

        var dialog = await DialogService.ShowAsync<PlanDialog>("Editar Plan", parameters, options);

        var result = await dialog.Result;

        if (!result.Canceled)
            await LoadPlanesAsync();

    }

    private async Task ConfirmDelete(PlanResponse plan)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };

        var parameters = new DialogParameters
        {
            ["Plan"] = plan,
            ["ContentText"] = $"¿Seguro que querés eliminar el plan \"{plan.Nombre}\"?",
            ["ButtonText"] = "Eliminar",
            ["Color"] = Color.Error
        };

        var dialog = await DialogService.ShowAsync<PlanDialogDelete>("Eliminar Plan", parameters, options);
        var result = await dialog.Result;

        if (result.Canceled)
            return;

        await LoadPlanesAsync();
    }
}