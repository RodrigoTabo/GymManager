@using GymManager.Shared.Contracts.Socios

<MudItem xs="12" sm="6" md="3">
    <MudPaper Class="pa-2" Elevation="2" Style="border-radius:18px;">
        <MudStack Spacing="2" AlignItems="AlignItems.Center">

            <MudStack AlignItems="AlignItems.Center" Spacing="0">
                <MudAvatar Variant="Variant.Filled" Color="@Color" Size="Size.Medium" Class="mb-1">
                    <MudIcon Icon="@Icon" />
                </MudAvatar>

                <MudText Typo="Typo.subtitle2">
                    @Titulo
                </MudText>
            </MudStack>

            <MudText Typo="Typo.h5" Align="Align.Center">
                @(Loading ? "—" : Valor.ToString())
            </MudText>

        </MudStack>
    </MudPaper>
</MudItem>


@code {

    [Parameter]
    public string Titulo { get; set; } = string.Empty;
    [Parameter]
    public string Valor { get; set; } = "0";
    [Parameter]
    public bool Loading { get; set; }
    [Parameter]
    public string Icon { get; set; } = Icons.Material.Filled.Info;
    [Parameter]
    public Color Color { get; set; } = Color.Primary;

}
