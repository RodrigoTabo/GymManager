@using GymManager.Shared.Contracts.Socios

    <MudPaper Class="pa-2" Elevation="2" Style="border-radius:5px;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">

                <MudAvatar Variant="Variant.Filled" Color="@Color" Size="Size.Large" Class="mb-1">
                    <MudIcon Icon="@Icon" Size="Size.Large" />
                </MudAvatar>

                <MudStack Spacing="0">
                    @if (!string.IsNullOrWhiteSpace(SubTitulo))
                    {
                        <MudText Typo="Typo.subtitle2" Style="font-weight: bold;">
                            @Titulo (@SubTitulo)
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.subtitle2" Style="font-weight: bold;">
                            @Titulo
                        </MudText>
                    }
                    <MudText Typo="Typo.h6" Style="font-weight: bold;">
                        @(Loading ? "—" : Valor.ToString())
                    </MudText>
                </MudStack>

            </MudStack>
        </MudStack>
    </MudPaper>

@code {

    [Parameter]
    public string Titulo { get; set; } = string.Empty;
    [Parameter]
    public string SubTitulo { get; set; } = string.Empty;
    [Parameter]
    public string Valor { get; set; } = "0";
    [Parameter]
    public bool Loading { get; set; }
    [Parameter]
    public string Icon { get; set; } = Icons.Material.Filled.Info;
    [Parameter]
    public Color Color { get; set; } = Color.Primary;

}
