{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "ConnectionStrings": {
    "GymManagerDbContext": "Server = .\\SQLEXPRESS; Initial Catalog = GymManager_DB; Integrated security = true; Trust Server Certificate = true"
    //"GymManagerDbContext": "Server=localhost,1433;Database=GymDb;User=sa;Password=YourStrongPassword123!;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "Qw8#rT9vL!pZ4xY2mS6@fH7bN0eW3kR1",
    "Issuer": "GymManagerAPI",
    "Audience": "GymManagerClient",
    "ExpireMinutes": 60
  }
}